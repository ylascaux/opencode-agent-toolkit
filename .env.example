# Native OpenCode. Both launchers ignore old Docker/sandbox runtime settings.
OPENCODE_MAJOR=1
OAT_RUNTIME=host
# Override the native executable only when it is not in PATH.
# OPENCODE_BIN=/absolute/path/to/opencode
# Optional explicit server transport authentication; does not authenticate providers.
# Use the same value for `oc2 serve` and its client, in .env.local, not here.
# OPENCODE_SERVER_PASSWORD=
# Provider authentication: oc auth login / oc2 auth login

# Model tiers. Keep personal/provider secrets and overrides in .env.local.
MODEL_PROFILE=copilot
MODEL_LOW=github-copilot/gpt-5.6-luna
MODEL_MEDIUM=github-copilot/gpt-5.6-terra
MODEL_HIGH=github-copilot/gpt-5.6-sol
MAX_PARALLEL_SUBAGENTS=3
# MODEL_BUILDER=openai/gpt-5.3-codex

# Optional external memory plugin, shared with Codex through its existing MCP facade.
# Enable with: oc memory enable git@github.com:USER/opencode-memory.git
OAT_MEMORY_ENABLED=0
OAT_MEMORY_CAPTURE_ENABLED=0
OAT_MEMORY_PLUGIN_AUTO_SYNC=1
OAT_MEMORY_PLUGIN_SYNC_INTERVAL_SECONDS=300
OAT_MEMORY_AUTO_SYNC=1
OAT_MEMORY_SYNC_INTERVAL_SECONDS=300
OAT_MEMORY_MAX_CHARS=12000
OAT_MEMORY_STRICT=0
OAT_MEMORY_CAPTURE_MAX_INPUT_CHARS=18000
OAT_MEMORY_MAX_CANDIDATES_PER_SESSION=5
# OAT_MEMORY_REPO=git@github.com:USER/opencode-memory.git
# OAT_MEMORY_DIR=$HOME/.local/share/opencode-agent-toolkit/memory
# OAT_MEMORY_PLUGIN_DIR=$HOME/.local/share/opencode-agent-toolkit/plugins/opencode-memory-plugin
# OAT_MEMORY_PLUGIN_REF=...
# OAT_MEMORY_PROJECT=...
# OAT_MEMORY_EXTRA_HATS=...
# OAT_GITHUB_TOKEN=... # put the actual value in .env.local, never in this file

# Optional inventory tooling (not installed as part of oc/oc2).
PROJECTS_ROOT=$HOME/Projects
