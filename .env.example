# OpenCode runtime compatibility.
OPENCODE_MAJOR=1
# Optional binary override: OPENCODE_BIN=/opt/homebrew/bin/opencode
# OpenCode 2 background subagents are experimental when enabled by the runtime.
# OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true

# Optional model-discovery settings used only by `just configure`.
# Credentials are read from the process environment and are not persisted by the configurator.
# LITELLM_BASE_URL=https://gateway.example.com
# LITELLM_API_KEY=
# CF_ACCESS_TOKEN=
# LITELLM_HEADERS_JSON={"x-custom-header":"value"}
# LITELLM_PROVIDER_PREFIX=litellm

# Per-agent model mapping. Defaults are safe generic router values; `just configure` can specialize them.
MODEL_META_ROUTER=litellm/smart-router
MODEL_ORCHESTRATOR=litellm/smart-router
MODEL_REVIEW_LEAD=litellm/smart-router
MODEL_SECURITY_LEAD=litellm/smart-router
MODEL_ARBITER=litellm/smart-router
MODEL_DEEP_REASONER=litellm/smart-router
MODEL_EVIDENCE_AUDITOR=litellm/smart-router
MODEL_BRAINSTORM=litellm/smart-router
MODEL_PLANNER=litellm/smart-router
MODEL_BUILDER=litellm/smart-router
MODEL_REVIEWER=litellm/smart-router
MODEL_TESTER=litellm/smart-router
MODEL_MOCK_GENERATOR=litellm/smart-router
MODEL_DEBUGGER=litellm/smart-router
MODEL_API_CONTRACT=litellm/smart-router
MODEL_PERFORMANCE=litellm/smart-router
MODEL_PROJECT_SCANNER=litellm/smart-router
MODEL_ARCHITECTURE=litellm/smart-router
MODEL_PLATFORM_ARCHITECT=litellm/smart-router
MODEL_AWS=litellm/smart-router
MODEL_TERRAFORM=litellm/smart-router
MODEL_KUBERNETES=litellm/smart-router
MODEL_PYTHON=litellm/smart-router
MODEL_GO=litellm/smart-router
MODEL_CICD=litellm/smart-router
MODEL_SRE=litellm/smart-router
MODEL_OBSERVABILITY=litellm/smart-router
MODEL_FINOPS=litellm/smart-router
MODEL_DATABASE=litellm/smart-router
MODEL_NETWORKING=litellm/smart-router
MODEL_THREAT_MODEL=litellm/smart-router
MODEL_APPSEC=litellm/smart-router
MODEL_IAC_SECURITY=litellm/smart-router
MODEL_SUPPLY_CHAIN=litellm/smart-router
MODEL_SECRETS=litellm/smart-router
MODEL_PENTEST=litellm/smart-router
MODEL_DOCS=litellm/smart-router

# Multi-repository architecture discovery
PROJECTS_ROOT=$HOME/Projects
