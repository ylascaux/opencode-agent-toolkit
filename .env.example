# OpenCode 2 stable is the only OpenCode runtime used by the toolkit.
OAT_RUNTIME=host
# Optional native binary override; oc otherwise uses 'opencode'.
# OPENCODE_BIN=/absolute/path/to/opencode

# Model profile; switch with `just profile copilot` or `just profile codex`.
MODEL_PROFILE=copilot
MODEL_LOW=github-copilot/gpt-6-luna
MODEL_MEDIUM=github-copilot/gpt-6-luna
MODEL_HIGH=github-copilot/gpt-6-sol
# MODEL_BUILDER=openai/gpt-5.3-codex

# Persistent memory: upstream create-ai-memory package + private Markdown/Git vault.
OAT_AI_MEMORY_ENABLED=1
OAT_AI_MEMORY_VERSION=0.15.4
OAT_AI_MEMORY_ROOT=$HOME/opencode-memory
OAT_AI_MEMORY_REPO=https://github.com/ylascaux/opencode-memory.git
# Optional package install location override:
# OAT_AI_MEMORY_VENDOR_DIR=$HOME/.local/share/opencode-agent-toolkit/vendor/ai-memory

# Legacy private memory data is only used by the optional Codex MCP path.
OAT_MEMORY_ENABLED=0
OAT_MEMORY_CAPTURE_ENABLED=0
# OAT_MEMORY_REPO=git@github.com:USER/opencode-memory.git
# OAT_MEMORY_DIR=$HOME/.local/share/opencode-agent-toolkit/memory
# OAT_MEMORY_PLUGIN_DIR=$HOME/.local/share/opencode-agent-toolkit/plugins/opencode-memory-plugin

PROJECTS_ROOT=$HOME/Projects
