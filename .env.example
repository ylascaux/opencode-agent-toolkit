# Native launchers: oc = V1, oc2 = V2. No Docker or sandbox setup is required.
OPENCODE_MAJOR=1
OAT_RUNTIME=host
# Optional native binary override; oc/oc2 otherwise use opencode/opencode2.
# OPENCODE_BIN=/absolute/path/to/opencode2

# Model profile; switch with `just profile copilot` or `just profile codex`.
# Existing per-agent overrides in .env.local take priority over profile changes.
MODEL_PROFILE=copilot
MODEL_LOW=github-copilot/gpt-5.6-luna
MODEL_MEDIUM=github-copilot/gpt-5.6-terra
MODEL_HIGH=github-copilot/gpt-5.6-sol
# MODEL_BUILDER=openai/gpt-5.3-codex

# Optional external memory CLI / Codex MCP. Native oc/oc2 do not load the
# automatic capture plugins. See README before enabling old plugin settings.
OAT_MEMORY_ENABLED=0
OAT_MEMORY_CAPTURE_ENABLED=0
# OAT_MEMORY_REPO=git@github.com:USER/opencode-memory.git
# OAT_MEMORY_DIR=$HOME/.local/share/opencode-agent-toolkit/memory
# OAT_MEMORY_PLUGIN_DIR=$HOME/.local/share/opencode-agent-toolkit/plugins/opencode-memory-plugin
# Private repository authentication belongs in the environment or .env.local,
# never in this tracked example. Memory is not synced during native startup.

# Optional inventory tools, invoked explicitly rather than installed at startup.
PROJECTS_ROOT=$HOME/Projects
