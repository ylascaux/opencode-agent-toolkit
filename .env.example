# Stable OpenCode 2 only. The toolkit installs @opencode/cli and exposes it as oc.
OAT_RUNTIME=host
# Optional binary override.
# OPENCODE_BIN=/absolute/path/to/opencode

# Set to 0 if OpenCode is managed externally (for example Homebrew).
OAT_INSTALL_OPENCODE=1
# Set to 0 to skip plugin installation during bootstrap/CI.
OAT_INSTALL_PLUGINS=1

# Model profile; switch with `just profile copilot` or `just profile codex`.
MODEL_PROFILE=copilot
MODEL_LOW=github-copilot/gpt-5.6-luna
MODEL_MEDIUM=github-copilot/gpt-5.6-terra
MODEL_HIGH=github-copilot/gpt-5.6-sol
# MODEL_BUILDER=openai/gpt-5.3-codex

# Maintained third-party memory plugin for OpenCode 2.
OAT_MEMORY_ENABLED=1
OAT_MEMORY_PLUGIN=opencode-mem@2.26.0
# Optional provider override. Otherwise inferred from MODEL_MEDIUM/HIGH/LOW.
# OAT_MEMORY_PROVIDER=github-copilot

# Optional inventory tools.
PROJECTS_ROOT=$HOME/Projects
