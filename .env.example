# OpenCode runtime compatibility.
OPENCODE_MAJOR=1
# Optional binary override: OPENCODE_BIN=/opt/homebrew/bin/opencode
# OpenCode 2 background subagents are experimental when enabled by the runtime.
# OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true

# Active model profile. GitHub Copilot is the default work profile.
# Switch with: just profile copilot | just profile codex
MODEL_PROFILE=copilot
MODEL_LOW=github-copilot/gpt-5.6-luna
MODEL_MEDIUM=github-copilot/gpt-5.6-terra
MODEL_HIGH=github-copilot/gpt-5.6-sol

# Optional per-agent overrides belong in .env.local so profile switching never overwrites them.
# Example:
# MODEL_BUILDER=openai/gpt-5.3-codex
# MODEL_REVIEWER=github-copilot/gpt-5.6-sol

# Optional LiteLLM discovery remains available for future gateway usage via `just configure`.
# Credentials are read from the process environment and are not persisted by the configurator.
# LITELLM_BASE_URL=https://gateway.example.com
# LITELLM_API_KEY=
# CF_ACCESS_TOKEN=
# LITELLM_HEADERS_JSON={"x-custom-header":"value"}
# LITELLM_PROVIDER_PREFIX=litellm

# Multi-repository architecture discovery
PROJECTS_ROOT=$HOME/Projects
