# OpenCode runtime compatibility.
OPENCODE_MAJOR=1
# Optional binary override: OPENCODE_BIN=/opt/homebrew/bin/opencode
# OpenCode 2 background subagents are experimental when enabled by the runtime.
# OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true

# Active model profile. GitHub Copilot is the default work profile.
# Switch with: just profile copilot | just profile codex
MODEL_PROFILE=copilot
MODEL_LOW=github-copilot/gpt-5.6-luna
MODEL_MEDIUM=github-copilot/gpt-5.6-terra
MODEL_HIGH=github-copilot/gpt-5.6-sol

# Optional per-agent overrides belong in .env.local so profile switching never overwrites them.
# Example:
# MODEL_BUILDER=openai/gpt-5.3-codex
# MODEL_REVIEWER=github-copilot/gpt-5.6-sol

# Runtime reliability profile: cheap | normal | premium.
# These profiles affect watchdog defaults only; every value can be overridden below.
OC_RUNTIME_PROFILE=normal
OC_RUNTIME_GUARDS=1
OC_PREFLIGHT=1
OC_PREFLIGHT_AUTH=1
OC_PREFLIGHT_MODELS=1

# Deterministic subagent concurrency control. Extra launches wait in a queue and do not consume an LLM call.
OC_MAX_PARALLEL_SUBAGENTS=3
# Optional per-lead overrides:
# OC_MAX_PARALLEL_META_ROUTER=2
# OC_MAX_PARALLEL_ORCHESTRATOR=3
# OC_MAX_PARALLEL_REVIEW_LEAD=3
# OC_MAX_PARALLEL_PLATFORM_ARCHITECT=3
# OC_MAX_PARALLEL_SECURITY_LEAD=3

# Watchdog / circuit-breaker limits.
OC_STALLED_TIMEOUT_SECONDS=180
OC_MAX_AGENT_DURATION_SECONDS=600
OC_MAX_SAME_FAILURE=2
OC_SUBAGENT_QUEUE_TIMEOUT_SECONDS=600
OC_WATCHDOG_POLL_SECONDS=10

# Cost values use the cost unit reported by OpenCode/provider (normally USD).
# A value of 0 disables that cost limit; step/time/stall limits remain active.
OC_MAX_CHILD_COST=0.50
OC_MAX_RUN_COST=2.00

# Optional step overrides. Generated configs otherwise use conservative built-in defaults.
# OC_DEFAULT_AGENT_STEPS=12
# OC_STEPS_ORCHESTRATOR=16
# OC_STEPS_BUILDER=16

# Optional LiteLLM discovery remains available for future gateway usage via `just configure`.
# Credentials are read from the process environment and are not persisted by the configurator.
# LITELLM_BASE_URL=https://gateway.example.com
# LITELLM_API_KEY=
# CF_ACCESS_TOKEN=
# LITELLM_HEADERS_JSON={"x-custom-header":"value"}
# LITELLM_PROVIDER_PREFIX=litellm

# Multi-repository architecture discovery
PROJECTS_ROOT=$HOME/Projects
