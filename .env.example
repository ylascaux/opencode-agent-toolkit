# OpenCode 2 stable is the only OpenCode runtime used by the toolkit.
OAT_RUNTIME=host
# Optional native binary override; oc otherwise uses 'opencode'.
# OPENCODE_BIN=/absolute/path/to/opencode

# Model profile; switch with `just profile copilot` or `just profile codex`.
MODEL_PROFILE=copilot
MODEL_LOW=github-copilot/gpt-6-luna
MODEL_MEDIUM=github-copilot/gpt-6-luna
MODEL_HIGH=github-copilot/gpt-6-sol
# MODEL_BUILDER=openai/gpt-5.3-codex

# Current library/framework documentation through Context7.
# Uses the official remote MCP endpoint; no local package is installed.
OAT_CONTEXT7_ENABLED=1
# Optional higher-rate authentication. The key is never written to generated config.
# CONTEXT7_API_KEY=

# V2 ACP runner foundation. OpenCode is the default trusted native ACP runner.
OAT_ACP_ENABLED=1
OAT_ACP_DEFAULT_RUNNER=opencode
OAT_ACP_MAX_PARALLEL=4
OAT_ACP_TIMEOUT_SECONDS=600

# V2 memory backend selector. "legacy" keeps the current Git/Markdown runtime
# until the PostgreSQL integration is qualified; V2 does not migrate V1 data.
OAT_MEMORY_BACKEND=legacy
OAT_MEMORY_NAMESPACE_PREFIX=oat
# OAT_MEMORY_POSTGRES_DSN=postgresql://user:password@host:5432/opencode_memory

# Persistent memory: native opencode-memory-plugin + private Markdown/Git vault.
# Capture is automatic at session idle. HIGH-confidence memory is persisted and pushed automatically;
# ambiguous MEDIUM-confidence items stay quarantined locally.
OAT_MEMORY_ENABLED=1
OAT_MEMORY_CAPTURE_ENABLED=1
OAT_MEMORY_AUTO_PROMOTE=1
OAT_MEMORY_AUTO_PUSH=1
OAT_MEMORY_TRACE=1
OAT_MEMORY_REPO=https://github.com/ylascaux/opencode-memory.git
OAT_MEMORY_DIR=$HOME/opencode-memory
# OAT_MEMORY_CANDIDATE_DIR=$HOME/.local/state/opencode-agent-toolkit/memory
# OAT_MEMORY_PLUGIN_DIR=$HOME/.local/share/opencode-agent-toolkit/plugins/opencode-memory-plugin
# OAT_MEMORY_AUTO_SYNC=1
# OAT_MEMORY_SYNC_INTERVAL_SECONDS=300

PROJECTS_ROOT=$HOME/Projects
