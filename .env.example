# OpenCode runtime compatibility.
OPENCODE_MAJOR=1
# Optional binary override: OPENCODE_BIN=/opt/homebrew/bin/opencode
# OpenCode 2 background subagents are experimental when enabled by the runtime.
# OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true

# Plan approval gate.
# off     = current behavior, no plan gate
# changes = default; read-only discovery is allowed, mutations wait for plan approval
# always  = approval is also required before delegated execution beyond direct discovery
PLAN_APPROVAL_MODE=changes

# Reliability guardrails. Profiles only provide defaults; explicit values below win.
# cheap | normal | premium
RELIABILITY_PROFILE=normal
OPENCODE_PREFLIGHT=1
OPENCODE_PREFLIGHT_AUTH=1
OPENCODE_PREFLIGHT_MODELS=1
# OPENCODE_PREFLIGHT_STRICT=1
MAX_PARALLEL_SUBAGENTS=3
# Optional per-lead overrides. When unset, MAX_PARALLEL_SUBAGENTS is used.
# MAX_PARALLEL_META_ROUTER=2
# MAX_PARALLEL_ORCHESTRATOR=3
# MAX_PARALLEL_REVIEW_LEAD=3
# MAX_PARALLEL_PLATFORM_ARCHITECT=3
# MAX_PARALLEL_SECURITY_LEAD=2
SUBAGENT_QUEUE_TIMEOUT_SECONDS=600
SUBAGENT_HEARTBEAT_TIMEOUT_SECONDS=60
SUBAGENT_STALLED_TIMEOUT_SECONDS=180
SUBAGENT_MAX_DURATION_SECONDS=900
SUBAGENT_WATCH_INTERVAL_SECONDS=15
MAX_SAME_ERROR=2
MAX_PROVIDER_RETRIES=2
MAX_SUBAGENT_RETRIES=2

# Sandboxed shell execution. Disabled by default for compatibility; enable with `just sandbox-on`.
OAT_SANDBOX_ENABLED=0
OAT_SANDBOX_ENGINE=auto
OAT_SANDBOX_AUTOBUILD=1
OAT_SANDBOX_IMAGE=opencode-agent-toolkit-sandbox:local

# External OpenCode memory plugin. Memory and capture remain disabled by default.
# The toolkit owns only installation/configuration; the memory implementation lives in:
# https://github.com/ylascaux/opencode-memory-plugin
OAT_MEMORY_ENABLED=0
OAT_MEMORY_CAPTURE_ENABLED=0
OAT_MEMORY_PLUGIN_REPO=git@github.com:ylascaux/opencode-memory-plugin.git
# Pin a release tag here once published, e.g. v0.1.0. `main` is the bootstrap default.
OAT_MEMORY_PLUGIN_REF=main
# OAT_MEMORY_PLUGIN_DIR=$HOME/.local/share/opencode-agent-toolkit/plugins/opencode-memory-plugin
OAT_MEMORY_PLUGIN_AUTO_SYNC=1
OAT_MEMORY_PLUGIN_SYNC_INTERVAL_SECONDS=300

# Private Git repository containing projects/workstyle/hats/inbox data.
# Enable with: just memory-on git@github.com:USER/opencode-memory.git
# OAT_MEMORY_REPO=git@github.com:USER/opencode-memory.git
# Existing toolkit installs keep this default path automatically.
# OAT_MEMORY_DIR=$HOME/.local/share/opencode-agent-toolkit/memory
OAT_MEMORY_AUTO_SYNC=1
OAT_MEMORY_SYNC_INTERVAL_SECONDS=300
OAT_MEMORY_MAX_CHARS=12000
OAT_MEMORY_STRICT=0
# OAT_MEMORY_PROJECT=
# OAT_MEMORY_EXTRA_HATS=

# Automatic extraction settings. Candidates stay local until explicitly accepted/promoted.
OAT_MEMORY_CAPTURE_MAX_INPUT_CHARS=18000
OAT_MEMORY_MAX_CANDIDATES_PER_SESSION=5
# Defaults to MODEL_LOW when unset.
# OAT_MEMORY_EXTRACTOR_MODEL=github-copilot/gpt-5.6-luna
# OAT_MEMORY_CANDIDATE_DIR=$HOME/.local/state/opencode-agent-toolkit/memory

# Active model profile. GitHub Copilot is the default work profile.
# Switch with: just profile copilot | just profile codex
MODEL_PROFILE=copilot
MODEL_LOW=github-copilot/gpt-5.6-luna
MODEL_MEDIUM=github-copilot/gpt-5.6-terra
MODEL_HIGH=github-copilot/gpt-5.6-sol

# Optional per-agent overrides belong in .env.local so profile switching never overwrites them.
# MODEL_BUILDER=openai/gpt-5.3-codex
# MODEL_REVIEWER=github-copilot/gpt-5.6-sol

# Optional LiteLLM discovery remains available for future gateway usage via `just configure-litellm`.
# Credentials are read from the process environment and are not persisted by the configurator.
# LITELLM_BASE_URL=https://gateway.example.com
# LITELLM_API_KEY=
# CF_ACCESS_TOKEN=
# LITELLM_HEADERS_JSON={"x-custom-header":"value"}
# LITELLM_PROVIDER_PREFIX=litellm

# Multi-repository architecture discovery
PROJECTS_ROOT=$HOME/Projects
