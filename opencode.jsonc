curity.md}","steps":18,"permissions":[{"action":"edit","resource":"*","effect":"deny"},{"action":"shell","resource":"*","effect":"deny"},{"action":"read","resource":"*.env","effect":"deny"},{"action":"read","resource":"*.pem","effect":"deny"}]},"supply-chain":{"description":"Review dependency and build supply-chain risk","mode":"subagent","model":"{env:MODEL_SUPPLY_CHAIN}","system":"{file:./prompts/supply-chain.md}","steps":16,"permissions":[{"action":"edit","resource":"*","effect":"deny"},{"action":"shell","resource":"*","effect":"deny"},{"action":"read","resource":"*.env","effect":"deny"},{"action":"read","resource":"*.pem","effect":"deny"}]},"pentest":{"description":"You are an authorized, non-destructive security validation agent","mode":"subagent","model":"{env:MODEL_PENTEST}","system":"{file:./prompts/pentest.md}","steps":20,"permissions":[{"action":"edit","resource":"*","effect":"deny"},{"action":"shell","resource":"*","effect":"ask"},{"action":"shell","resource":"curl http://127.0.0.1*","effect":"allow"},{"action":"shell","resource":"curl http://localhost*","effect":"allow"},{"action":"shell","resource":"curl https://127.0.0.1*","effect":"allow"},{"action":"shell","resource":"curl https://localhost*","effect":"allow"},{"action":"read","resource":"*.env","effect":"deny"},{"action":"read","resource":"*.pem","effect":"deny"},{"action":"read","resource":"*id_rsa*","effect":"deny"}]},"secrets":{"description":"Read-only secret and sensitive-data auditor","mode":"subagent","model":"{env:MODEL_SECRETS}","system":"{file:./prompts/secrets.md}","steps":12,"permissions":[{"action":"edit","resource":"*","effect":"deny"},{"action":"shell","resource":"*","effect":"deny"},{"action":"read","resource":"*.env","effect":"deny"},{"action":"read","resource":"*.pem","effect":"deny"}]},"docs-writer":{"description":"Write concise technical docs grounded in verified implementation","mode":"subagent","model":"{env:MODEL_DOCS}","system":"{file:./prompts/docs-writer.md}","steps":14,"permissions":[{"action":"edit","resource":"*","effect":"allow"},{"action":"shell","resource":"*","effect":"ask"}]}},"commands":{"ship":{"description":"Implement with tests, review and security gates","template":"Implement $ARGUMENTS. Use planner when non-trivial, the narrowest implementation specialist, tester, reviewer, and all security gates relevant to the changed attack surface. Do not finish until verification evidence is summarized.","agent":"orchestrator"},"architecture":{"description":"Run architecture council","template":"Design or review the architecture for $ARGUMENTS. Use project-scanner when repository evidence is needed, then platform-architect, AWS/Kubernetes/Terraform/SRE/observability/FinOps specialists as relevant, plus threat-model and IaC security. Produce a decision matrix, Mermaid diagrams, migration plan and residual risks.","agent":"orchestrator"},"security":{"description":"Run full security review","template":"Perform a security review of $ARGUMENTS. Invoke threat-model, appsec, iac-security, supply-chain, secrets and pentest where authorized/applicable. Deduplicate findings, rank by severity and confidence, and provide remediation plus verification.","agent":"orchestrator"},"debug":{"description":"Evidence-first debug workflow","template":"Debug $ARGUMENTS. Start with debugger, then delegate to the relevant language/platform specialist, add a regression test, and run reviewer/security review if the fix affects a trust boundary.","agent":"orchestrator"}}}