{"$schema":"https://opencode.ai/config.json","default_agent":"orchestrator","agents":{"orchestrator":{"description":"You are the principal engineering orchestrator","mode":"primary","model":"{env:MODEL_ORCHESTRATOR}","system":"{file:./prompts/orchestrator.md}","steps":36,"permissions":[{"action":"subagent","resource":"*","effect":"deny"},{"action":"subagent","resource":"brainstorm","effect":"allow"},{"action":"subagent","resource":"planner","effect":"allow"},{"action":"subagent","resource":"builder","effect":"allow"},{"action":"subagent","resource":"reviewer","effect":"allow"},{"action":"subagent","resource":"tester","effect":"allow"},{"action":"subagent","resource":"mock-generator","effect":"allow"},{"action":"subagent","resource":"debugger","effect":"allow"},{"action":"subagent","resource":"project-scanner","effect":"allow"},{"action":"subagent","resource":"architecture-designer","effect":"allow"},{"action":"subagent","resource":"platform-architect","effect":"allow"},{"action":"subagent","resource":"aws-platform","effect":"allow"},{"action":"subagent","resource":"terraform-terragrunt","effect":"allow"},{"action":"subagent","resource":"kubernetes","effect":"allow"},{"action":"subagent","resource":"python-specialist","effect":"allow"},{"action":"subagent","resource":"go-specialist","effect":"allow"},{"action":"subagent","resource":"cicd","effect":"allow"},{"action":"subagent","resource":"sre","effect":"allow"},{"action":"subagent","resource":"observability","effect":"allow"},{"action":"subagent","resource":"finops","effect":"allow"},{"action":"subagent","resource":"threat-model","effect":"allow"},{"action":"subagent","resource":"appsec","effect":"allow"},{"action":"subagent","resource":"iac-security","effect":"allow"},{"action":"subagent","resource":"supply-chain","effect":"allow"},{"action":"subagent","resource":"pentest","effect":"allow"},{"action":"subagent","resource":"secrets","effect":"allow"},{"action":"subagent","resource":"docs-writer","effect":"allow"},{"a