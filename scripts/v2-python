#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import subprocess
import sys
import venv
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DATA_HOME = Path(os.getenv("XDG_DATA_HOME") or Path.home() / ".local/share")
VENV = Path(os.getenv("OAT_V2_PYTHON_DIR") or DATA_HOME / "opencode-agent-toolkit" / "python-v2")
REQ = ROOT / "requirements-v2.txt"


def python_path() -> Path:
    return VENV / ("Scripts/python.exe" if os.name == "nt" else "bin/python")


def ensure() -> int:
    target = python_path()
    if not target.exists():
        VENV.parent.mkdir(parents=True, exist_ok=True)
        venv.EnvBuilder(with_pip=True, clear=False).create(VENV)
    check = subprocess.run(
        [str(target), "-c", "import harness_memory, psycopg"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if check.returncode != 0:
        subprocess.run(
            [
                str(target),
                "-m",
                "pip",
                "install",
                "--disable-pip-version-check",
                "--upgrade",
                "-r",
                str(REQ),
            ],
            check=True,
        )
    print(target)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("ensure", "path"))
    args = parser.parse_args()
    if args.action == "ensure":
        return ensure()
    target = python_path()
    if not target.is_file():
        print("V2 Python runtime is not installed; run 'just install'.", file=sys.stderr)
        return 1
    print(target)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
