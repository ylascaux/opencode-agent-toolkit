#!/usr/bin/env python3
from __future__ import annotations

import json
import os
from pathlib import Path

from agent_config import GENERATED_PROMPTS_DIR, children_by_parent, load_agents

ROOT = Path(__file__).resolve().parents[1]
POLICY = json.loads((ROOT / "reliability.json").read_text())
PLAN_APPROVAL_MODES = {"off", "changes", "always"}
GENERATED_V1_PROMPTS_DIR = ROOT / ".generated" / "prompts-v1"


def profile() -> tuple[str, dict]:
    name = os.getenv("RELIABILITY_PROFILE", POLICY.get("default_profile", "normal")).strip().lower()
    profiles = POLICY.get("profiles", {})
    if name not in profiles:
        allowed = ", ".join(sorted(profiles))
        raise SystemExit(f"RELIABILITY_PROFILE must be one of: {allowed} (got {name!r})")
    return name, profiles[name]


def plan_approval_mode() -> str:
    default = str(POLICY.get("plan_approval", {}).get("default_mode", "changes")).strip().lower()
    raw = os.getenv("PLAN_APPROVAL_MODE", default).strip().lower()
    if raw not in PLAN_APPROVAL_MODES:
        allowed = ", ".join(sorted(PLAN_APPROVAL_MODES))
        raise SystemExit(f"PLAN_APPROVAL_MODE must be one of: {allowed} (got {raw!r})")
    return raw


def env_int(name: str, default: int) -> int:
    raw = os.getenv(name)
    if raw is None or raw == "":
        return default
    try:
        value = int(raw)
    except ValueError as exc:
        raise SystemExit(f"{name} must be an integer (got {raw!r})") from exc
    if value < 1:
        raise SystemExit(f"{name} must be >= 1 (got {value})")
    return value


def patch_config(path: Path, *, v2: bool) -> None:
    data = json.loads(path.read_text())
    agents_key = "agents" if v2 else "agent"
    agents = data.get(agents_key, {})
    caps = POLICY["step_caps"]

    policy_default = int(caps["default"])
    default_override = env_int("MAX_STEPS_DEFAULT", policy_default)
    default_cap = min(policy_default, default_override)

    for name, agent in agents.items():
        policy_cap = int(caps.get(name, default_cap))
        env_name = "MAX_STEPS_" + name.upper().replace("-", "_")
        requested_cap = env_int(env_name, policy_cap)
        cap = min(policy_cap, requested_cap)
        current = int(agent.get("steps", cap))
        agent["steps"] = min(current, cap)

    plugins = data.setdefault("plugins" if v2 else "plugin", [])
    runtime_plugin = (
        "./runtime/plugins/reliability-v2.ts"
        if v2
        else "./runtime/plugins/reliability-v1.js"
    )
    if runtime_plugin not in plugins:
        plugins.append(runtime_plugin)

    if v2:
        plan_approval_plugin = "./runtime/plugins/plan-approval-v2.ts"
        if plan_approval_plugin not in plugins:
            plugins.append(plan_approval_plugin)
        approval_plugin = "./plugins/reliability-approval"
        if approval_plugin not in plugins:
            plugins.append(approval_plugin)

    path.write_text(json.dumps(data, indent=2) + "\n")


def lead_parallel(lead: str, default: int) -> int:
    global_limit = env_int("MAX_PARALLEL_SUBAGENTS", default)
    env_name = POLICY.get("lead_parallel_env", {}).get(lead)
    return env_int(env_name, global_limit) if env_name else global_limit


def prepare_v1_prompts() -> None:
    GENERATED_V1_PROMPTS_DIR.mkdir(parents=True, exist_ok=True)
    for old in GENERATED_V1_PROMPTS_DIR.glob("*.md"):
        old.unlink()
    for source in GENERATED_PROMPTS_DIR.glob("*.md"):
        (GENERATED_V1_PROMPTS_DIR / source.name).write_text(source.read_text())


def append_prompt_policy() -> None:
    profile_name, defaults = profile()
    max_same_error = env_int("MAX_SAME_ERROR", int(defaults["max_same_error"]))
    max_subagent_retries = env_int(
        "MAX_SUBAGENT_RETRIES",
        int(defaults.get("max_subagent_retries", defaults.get("max_retries", 1))),
    )
    stalled = env_int(
        "SUBAGENT_STALLED_TIMEOUT_SECONDS",
        int(defaults["stalled_timeout_seconds"]),
    )

    specs = load_agents()
    children = children_by_parent(specs)
    marker = "## Reliability and child supervision"

    for prompt_dir in (GENERATED_PROMPTS_DIR, GENERATED_V1_PROMPTS_DIR):
        for name, delegated_children in children.items():
            if not delegated_children:
                continue
            path = prompt_dir / f"{name}.md"
            if not path.exists():
                raise SystemExit(f"Missing generated prompt: {path.relative_to(ROOT)}")
            max_parallel = lead_parallel(name, int(defaults["max_parallel_subagents"]))
            block = f"""

## Reliability and child supervision
- Reliability profile: `{profile_name}`. Never have more than {max_parallel} delegated child agents RUNNING for this lead at the same time. Queue additional independent work until a runtime slot is free.
- Treat CONFIG/AUTH/PERMISSION/PROVIDER failures differently from code/test failures. Do not repeatedly reason around a deterministic environment failure.
- If the same root cause is observed {max_same_error} times without new evidence, stop retrying that path and return BLOCKED or ESCALATION_REQUIRED.
- A child with no observable activity/progress for about {stalled} seconds is only STALL_SUSPECTED. Missing OpenCode telemetry is not proof that the child is stuck. Never cancel or replace it automatically because of this heuristic.
- In V2, the runtime may ask the user whether a suspected child should be killed. Continue waiting unless the user explicitly approves the interruption. In V1/headless mode, fail open and preserve the child.
- A lead with one or more active child delegations is WAITING_ON_CHILD, not STALLED. Do not cancel or restart the lead merely because its own tool/file progress is quiet while a child is running.
- WAITING_PERMISSION is not STALLED. Do not duplicate a child merely because it is waiting for a human permission decision.
- Before delegating, check whether an equivalent child task is already running or already returned COMPLETE. Reuse completed handoffs instead of paying for duplicate work.
- If a child is cancelled/aborted for a retryable runtime reason, retry only that failed child up to {max_subagent_retries} time(s). Never restart the parent lead or already COMPLETE sibling tasks solely because one leaf failed.
- When OpenCode exposes a previous `task_id`/child session id, resume that same child session on retry instead of creating a fresh child. Keep the same narrow task scope and add only the context needed to continue.
- Prefer checkpoints between discovery, implementation, tests and review so a later failure does not force successful phases to be repeated.
- After retries are exhausted, consume the failed child's checkpoint/handoff and decide once: continue with partial evidence, route to a distinct specialist, or return BLOCKED/ESCALATION_REQUIRED. Never create an unbounded retry chain.
"""
            text = path.read_text()
            if marker in text:
                text = text[: text.index(marker)].rstrip() + "\n"
            path.write_text(text.rstrip() + block + "\n")


def append_effective_plan_policy(prompt_dir: Path, mode: str) -> None:
    marker = "## Effective plan approval mode"
    mode_rules = {
        "off": (
            "Plan approval is disabled for this run. Do not pause solely for PLAN_APPROVAL_REQUIRED; "
            "follow the requested workflow normally while preserving all other permissions and safety rules."
        ),
        "changes": (
            "Read-only discovery/planning may proceed. Root/lead mutation requires a root-user-approved plan. "
            "Delegated leaves executing an explicitly approved scope do not request a second approval."
        ),
        "always": (
            "Direct read-only discovery may proceed, but delegated execution and mutation require a root-user-approved plan. "
            "After approval, delegated leaves execute the handed-off approved scope without asking again."
        ),
    }
    block = f"""

## Effective plan approval mode
- Effective `PLAN_APPROVAL_MODE`: `{mode}`.
- {mode_rules[mode]}
- The runtime gate is authoritative; never retry around a blocked mutating/delegation tool.
"""

    for path in prompt_dir.glob("*.md"):
        text = path.read_text()
        if marker in text:
            text = text[: text.index(marker)].rstrip() + "\n"
        path.write_text(text.rstrip() + block + "\n")


def main() -> None:
    profile()
    v2_plan_approval_mode = plan_approval_mode()
    patch_config(ROOT / "opencode.jsonc", v2=False)
    patch_config(ROOT / "opencode.v2.jsonc", v2=True)
    prepare_v1_prompts()
    append_prompt_policy()
    append_effective_plan_policy(GENERATED_V1_PROMPTS_DIR, "off")
    append_effective_plan_policy(GENERATED_PROMPTS_DIR, v2_plan_approval_mode)
    print("Reliability policies applied; plan approval is disabled in V1 and configured in V2")


if __name__ == "__main__":
    main()
