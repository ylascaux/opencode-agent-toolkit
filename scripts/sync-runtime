#!/usr/bin/env python3
"""Local adapter dispatch. Does not launch a runtime or load provider credentials."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys

# Also protects callers using `python3 scripts/sync-runtime` rather than oc/-B.
sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from runtime.common.normalization import load_normalized_agents  # noqa: E402
from runtime.codex.adapter import CodexAdapter  # noqa: E402
from runtime.opencode.adapter import OpenCodeAdapter  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("runtime", choices=("codex", "opencode", "all"))
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="show planned changes without writing")
    mode.add_argument("--check", action="store_true", help="exit 1 on drift, without repairing")
    parser.add_argument("--verbose", action="store_true", help="show resolved model policy and capability limitations")
    args = parser.parse_args()
    adapters = {"opencode": OpenCodeAdapter(ROOT), "codex": CodexAdapter(ROOT)}
    names = ("opencode", "codex") if args.runtime == "all" else (args.runtime,)
    try:
        specs = load_normalized_agents()
        # Render and validate every selected runtime before making any changes.
        plans = {name: adapters[name].plan(specs) for name in names}
        changes = {name: plan.changes() for name, plan in plans.items()}
        for name, plan in plans.items():
            print(f"{name} synchronization: {len(specs)} agents")
            for path, status in changes[name].items():
                print(f"  {status} {path.relative_to(ROOT)}")
            if args.verbose or args.dry_run:
                print("\n".join(plan.notes))
            if not args.dry_run and not args.check:
                plan.write()
            if not changes[name]:
                print(f"{name} artifacts are up to date.")
            elif args.check:
                print(f"{name} artifacts are out of date.")
            if name == "codex" and not args.verbose and not args.dry_run:
                print("WARNING: fine-grained permissions, lead child allowlists and step budgets are not enforced natively; inspect --verbose capability details.")
                print("Staged local bundle only; see .generated/codex/AGENTS.md for opt-in installation and runtime.json for capability limitations.")
            if name == "opencode":
                print("Raw OpenCode artifacts only (generate-config stage). Use just config to apply memory/reliability integration.")
        if args.dry_run:
            print("No files written (--dry-run).")
        if args.check:
            print("No files written (--check).")
        return 1 if args.check and any(changes.values()) else 0
    except (OSError, ValueError) as exc:
        print(f"Runtime synchronization failed: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
