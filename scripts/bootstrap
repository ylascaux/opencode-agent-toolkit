#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

refresh=0
if [[ "${1:-}" == "--refresh" ]]; then
  refresh=1
elif [[ $# -gt 0 ]]; then
  echo "Usage: $0 [--refresh]" >&2
  exit 2
fi

if [[ ! -f .env ]]; then
  cp .env.example .env
  echo "Created .env from .env.example (Copilot LOW/MEDIUM/HIGH profile)"
else
  echo "Keeping existing .env"

  # Backward-compatible migration from the previous 37 explicit MODEL_* layout.
  # Missing tier keys are appended without changing any existing per-agent mapping.
  legacy_model_overrides=0
  if grep -Eq '^MODEL_(META_ROUTER|ORCHESTRATOR|BUILDER|REVIEWER|PLATFORM_ARCHITECT|APPSEC)=' .env; then
    legacy_model_overrides=1
  fi

  for key in MODEL_LOW MODEL_MEDIUM MODEL_HIGH; do
    if ! grep -q "^${key}=" .env; then
      grep "^${key}=" .env.example >> .env
      echo "Added missing ${key} to existing .env"
    fi
  done

  if ! grep -q '^MODEL_PROFILE=' .env; then
    if [[ $legacy_model_overrides -eq 1 ]]; then
      echo 'MODEL_PROFILE=legacy-overrides' >> .env
      echo "Detected legacy per-agent model mappings; preserving them as overrides"
      echo "Run 'just profile copilot' or 'just profile codex' when you want to adopt tier-only mappings"
    else
      grep '^MODEL_PROFILE=' .env.example >> .env
      echo "Added missing MODEL_PROFILE to existing .env"
    fi
  fi
fi

set -a
source .env
[[ -f .env.local ]] && source .env.local
set +a

install_launchers() {
  bash "$ROOT/scripts/user-link" install oc
  bash "$ROOT/scripts/user-link" install oc2
}

# Docker is the default runtime. Nothing beyond Docker/Bash/Just is installed on
# the host: Python, Node, OpenCode, plugin dependencies and Nix live in the image.
if [[ "${OAT_RUNTIME:-docker}" == "docker" ]]; then
  if ! command -v docker >/dev/null 2>&1; then
    echo "Missing required command: docker" >&2
    exit 127
  fi
  if ! docker compose version >/dev/null 2>&1; then
    echo "Docker Compose v2 is required (docker compose)" >&2
    exit 127
  fi

  build_args=()
  [[ $refresh -eq 1 ]] && build_args+=(--refresh)
  bash "$ROOT/scripts/docker-build" "${build_args[@]}"

  echo
  echo "Installing launchers..."
  install_launchers

  echo
  echo "Restarting the OpenCode V2 server with the freshly built runtime image..."
  OAT_WORKSPACE_ROOT="$ROOT" OPENCODE_MAJOR=2 bash "$ROOT/scripts/docker-runtime" server restart

  echo
  echo "Setup complete (Docker runtime)."
  echo "  image : ${OAT_RUNTIME_IMAGE:-opencode-agent-toolkit:local}"
  echo "  oc    : installed"
  echo "  oc2   : installed"
  echo "  server: OC2 restarted"
  echo
  echo "Run 'oc' or 'oc2' from the project you want OpenCode to work on."
  echo "Use 'oc2 server status' to inspect the persistent V2 server."
  echo "Docker access uses the toolkit's dedicated DinD service; the host docker.sock is not mounted in OC/OC2."

  if ! command -v just >/dev/null 2>&1; then
    echo "Note: 'just' is recommended for the friendly command interface."
    [[ "$(uname -s)" == "Darwin" ]] && echo "macOS: brew install just"
  fi
  exit 0
fi

# Legacy host runtime. Kept for rollback/debugging with OAT_RUNTIME=host.
if ! command -v python3 >/dev/null 2>&1; then
  echo "Missing required command: python3" >&2
  exit 127
fi

if [[ ! -d .venv || $refresh -eq 1 ]]; then
  [[ $refresh -eq 1 ]] && rm -rf .venv
  python3 -m venv .venv
  echo "Created .venv"
fi

if [[ -f requirements.txt ]]; then
  .venv/bin/python -m pip install --disable-pip-version-check -q -r requirements.txt
  echo "Installed Python scanner/API dependencies"
fi

if [[ -f package.json ]]; then
  if ! command -v npm >/dev/null 2>&1; then
    echo "Missing required command: npm (required for OpenCode V2 plugin dependencies)" >&2
    exit 127
  fi

  if [[ -f package-lock.json ]]; then
    npm ci --no-audit --no-fund
  else
    npm install --no-audit --no-fund
    echo "Warning: package-lock.json was missing and has been generated; commit it for reproducible installs" >&2
  fi
  echo "Installed OpenCode plugin dependencies"
fi

python3 ./scripts/generate-config >/dev/null
python3 ./scripts/apply-reliability >/dev/null
python3 -m json.tool opencode.jsonc >/dev/null
python3 -m json.tool opencode.v2.jsonc >/dev/null
python3 -m unittest discover -s tests -v
python3 ./scripts/resolve-models --show >/dev/null
install_launchers

major="${OPENCODE_MAJOR:-1}"
case "$major" in
  1) expected="${OPENCODE_BIN:-opencode}" ;;
  2) expected="${OPENCODE_BIN:-opencode2}" ;;
  auto)
    if command -v opencode2 >/dev/null 2>&1; then expected="${OPENCODE_BIN:-opencode2}"; else expected="${OPENCODE_BIN:-opencode}"; fi
    ;;
  *) expected="opencode"; echo "Warning: OPENCODE_MAJOR must be 1, 2, or auto (got: $major)" >&2 ;;
esac

printf '\nSetup complete (legacy host runtime).\n'
echo "Reliability policy was applied to generated OpenCode configs."
echo "Launchers installed: oc, oc2"
echo "Recommended next steps:"
echo "  just reliability"
echo "  just models"
echo "  just doctor"
echo "  oc"

if ! command -v "$expected" >/dev/null 2>&1; then
  echo "Warning: selected OpenCode binary is not installed/found: $expected" >&2
fi
