#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1:-}" in
  ""|--refresh) ;;
  *) echo "Usage: $0 [--refresh]" >&2; exit 2 ;;
esac

command -v python3 >/dev/null 2>&1 || { echo "python3 is required" >&2; exit 127; }
python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' || {
  echo "Python 3.11 or newer is required" >&2
  exit 2
}

# Never replace or update an existing OpenCode installation.
if command -v opencode >/dev/null 2>&1; then
  printf 'OpenCode already installed: %s\n' "$(command -v opencode)"
  printf 'Keeping existing OpenCode version: %s\n' "$(opencode --version 2>/dev/null || echo unknown)"
else
  command -v npm >/dev/null 2>&1 || {
    echo "OpenCode is not installed and npm is unavailable. Install OpenCode 2 first." >&2
    exit 127
  }
  npm uninstall -g opencode-ai --no-audit --no-fund >/dev/null 2>&1 || true
  npm install -g @opencode/cli@latest --no-audit --no-fund
  command -v opencode >/dev/null 2>&1 || {
    echo "OpenCode 2 installation failed: opencode not found" >&2
    exit 127
  }
fi

# Rehydra is intentionally not part of this toolkit. OpenCode stores the exact
# configured package target, so remove all installed targets that match it.
rehydra_targets=()
while IFS= read -r target; do
  [[ -n "$target" ]] && rehydra_targets+=("$target")
done < <(
  opencode plugin list 2>/dev/null \
    | grep -oE '@rehydra/opencode(@[^[:space:]]+)?' \
    | sort -u \
    || true
)
rehydra_targets+=("@rehydra/opencode")
for target in "${rehydra_targets[@]}"; do
  opencode plugin remove "$target" >/dev/null 2>&1 || true
done
unset rehydra_targets target

if [[ ! -f "$ROOT/.env" ]]; then
  (umask 077; cp "$ROOT/.env.example" "$ROOT/.env")
fi

# Migrate the short-lived create-ai-memory configuration introduced in #86.
# Preserve unrelated settings in both .env and .env.local.
python3 - "$ROOT/.env" "$ROOT/.env.local" <<'PY'
from pathlib import Path
import re
import sys

for raw_path in sys.argv[1:]:
    path = Path(raw_path)
    if not path.is_file():
        continue
    lines = path.read_text().splitlines()
    values = {}
    for line in lines:
        match = re.match(r"^\s*([A-Z0-9_]+)=(.*)$", line)
        if match:
            values[match.group(1)] = match.group(2).strip()
    if not any(key.startswith("OAT_AI_MEMORY_") for key in values):
        continue

    enabled_raw = values.get("OAT_AI_MEMORY_ENABLED", "1")
    enabled = "0" if enabled_raw.lower() in {"0", "false", "no", "off"} else "1"
    repo = values.get("OAT_AI_MEMORY_REPO", "https://github.com/ylascaux/opencode-memory.git")
    root = values.get("OAT_AI_MEMORY_ROOT", "$HOME/opencode-memory")

    drop = {
        "OAT_MEMORY_ENABLED",
        "OAT_MEMORY_CAPTURE_ENABLED",
        "OAT_MEMORY_REPO",
        "OAT_MEMORY_DIR",
    }
    output = []
    for line in lines:
        match = re.match(r"^\s*([A-Z0-9_]+)=", line)
        key = match.group(1) if match else ""
        if key.startswith("OAT_AI_MEMORY_") or key in drop:
            continue
        output.append(line)

    while output and not output[-1].strip():
        output.pop()
    output.extend([
        "",
        "# Persistent memory: native opencode-memory-plugin + private Markdown/Git vault.",
        f"OAT_MEMORY_ENABLED={enabled}",
        f"OAT_MEMORY_CAPTURE_ENABLED={enabled}",
        f"OAT_MEMORY_AUTO_PROMOTE={enabled}",
        f"OAT_MEMORY_AUTO_PUSH={enabled}",
        f"OAT_MEMORY_REPO={repo}",
        f"OAT_MEMORY_DIR={root}",
    ])
    path.write_text("\n".join(output).rstrip() + "\n")
PY

set -a
source "$ROOT/.env"
[[ ! -f "$ROOT/.env.local" ]] || source "$ROOT/.env.local"
set +a

memory_backend="${OAT_MEMORY_BACKEND:-local}"
case "$memory_backend" in
  legacy|local|postgres) ;;
  *) echo "Unsupported OAT_MEMORY_BACKEND: $memory_backend" >&2; exit 2 ;;
esac

case "${OAT_MEMORY_ENABLED:-1}" in
  0|false|FALSE|no|NO|off|OFF)
    printf 'Persistent memory disabled by OAT_MEMORY_ENABLED.\n'
    ;;
  *)
    command -v git >/dev/null 2>&1 || { echo "git is required to install the OpenCode memory plugin." >&2; exit 127; }
    command -v node >/dev/null 2>&1 || { echo "node is required for the OpenCode memory plugin." >&2; exit 127; }
    python3 -B "$ROOT/scripts/memory_plugin.py" >/dev/null

    case "$memory_backend" in
      legacy)
        memory_repo="${OAT_MEMORY_REPO:-https://github.com/ylascaux/opencode-memory.git}"
        memory_dir="${OAT_MEMORY_DIR:-$HOME/opencode-memory}"
        [[ -n "$memory_repo" ]] || { echo "OAT_MEMORY_REPO cannot be empty while legacy memory is enabled." >&2; exit 2; }
        if [[ ! -d "$memory_dir" ]]; then
          if ! git clone "$memory_repo" "$memory_dir"; then
            printf '%s\n' "Unable to clone private memory repository: $memory_repo" >&2
            printf '%s\n' "Authenticate Git for GitHub, or point OAT_MEMORY_DIR at an existing local clone." >&2
            exit 1
          fi
        fi
        ;;
      local|postgres)
        python3 -B "$ROOT/scripts/v2-python" ensure >/dev/null
        ;;
    esac
    ;;
esac

python3 -B "$ROOT/scripts/configure-local"
bash "$ROOT/scripts/user-link" install oc
bash "$ROOT/scripts/user-link" uninstall oc2 || true

printf '\nToolkit launcher installed: oc\n'
case "${OAT_MEMORY_ENABLED:-1}" in
  0|false|FALSE|no|NO|off|OFF) ;;
  *)
    if [[ "$memory_backend" == legacy ]]; then
      printf 'Memory: legacy Git/Markdown + %s\n' "${OAT_MEMORY_DIR:-$HOME/opencode-memory}"
    else
      printf 'Memory: V2 %s harness-memory backend\n' "$memory_backend"
    fi
    ;;
esac
printf 'Run: oc --version && oc memory status\n'
