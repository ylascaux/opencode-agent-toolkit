#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
case "${1:-}" in
  ""|--refresh) ;;
  *) echo "Usage: $0 [--refresh]" >&2; exit 2 ;;
esac
command -v python3 >/dev/null 2>&1 || { echo "Install Python 3 first." >&2; exit 127; }

if [[ ! -f "$ROOT/.env" ]]; then
  (umask 077; cp "$ROOT/.env.example" "$ROOT/.env")
  echo "Created .env; existing installations keep their model and memory settings."
fi

# No system packages, virtualenv, npm install, image builds or server restart.
# Optional memory manages its own dependencies only when explicitly enabled.
bash "$ROOT/scripts/opencode-agents" config
bash "$ROOT/scripts/user-link" install oc
bash "$ROOT/scripts/user-link" install oc2
printf '\nNative launchers installed: oc / oc2.\n'
for binary in opencode opencode2; do
  if ! command -v "$binary" >/dev/null 2>&1; then
    echo "Not installed: $binary (see README for native installation)." >&2
  fi
done
printf 'Run oc or oc2 in your project. Authenticate with oc auth login / oc2 auth login.\n'
printf 'Old OAT_RUNTIME and sandbox settings are ignored by these launchers.\n'
