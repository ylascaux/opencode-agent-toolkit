#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

refresh=0
if [[ "${1:-}" == "--refresh" ]]; then
  refresh=1
elif [[ $# -gt 0 ]]; then
  echo "Usage: $0 [--refresh]" >&2
  exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "Missing required command: python3" >&2
  exit 127
fi

if [[ ! -f .env ]]; then
  cp .env.example .env
  echo "Created .env from .env.example (Copilot LOW/MEDIUM/HIGH profile)"
else
  echo "Keeping existing .env"
fi

if [[ ! -d .venv || $refresh -eq 1 ]]; then
  [[ $refresh -eq 1 ]] && rm -rf .venv
  python3 -m venv .venv
  echo "Created .venv"
fi

if [[ -f requirements.txt ]]; then
  .venv/bin/python -m pip install --disable-pip-version-check -q -r requirements.txt
  echo "Installed Python scanner/API dependencies"
fi

python3 ./scripts/generate-config >/dev/null
python3 -m json.tool opencode.jsonc >/dev/null
python3 -m json.tool opencode.v2.jsonc >/dev/null
python3 -m unittest discover -s tests -v

set -a
source .env
[[ -f .env.local ]] && source .env.local
set +a
python3 ./scripts/resolve-models --show >/dev/null

major="${OPENCODE_MAJOR:-1}"
case "$major" in
  1) expected="${OPENCODE_BIN:-opencode}" ;;
  2) expected="${OPENCODE_BIN:-opencode2}" ;;
  auto)
    if command -v opencode2 >/dev/null 2>&1; then expected="${OPENCODE_BIN:-opencode2}"; else expected="${OPENCODE_BIN:-opencode}"; fi
    ;;
  *) expected="opencode"; echo "Warning: OPENCODE_MAJOR must be 1, 2, or auto (got: $major)" >&2 ;;
esac

printf '\nSetup complete.\n'
echo "Recommended next steps:"
echo "  just models         # inspect LOW/MEDIUM/HIGH and effective agent mappings"
echo "  just doctor"
echo "  just install-user   # optional: create ~/.local/bin/oc for use from any workspace"
echo "  just run            # alternatively run directly from this repository"
echo "  just profile codex  # optional: switch to the personal Codex profile"

if ! command -v just >/dev/null 2>&1; then
  echo "Note: 'just' is recommended for the friendly command interface."
  [[ "$(uname -s)" == "Darwin" ]] && echo "macOS: brew install just"
fi

if ! command -v "$expected" >/dev/null 2>&1; then
  echo "Warning: selected OpenCode binary is not installed/found: $expected" >&2
  [[ "$major" == "2" ]] && echo "OpenCode 2 beta: npm install -g @opencode-ai/cli@beta" >&2
fi
