#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1:-}" in
  ""|--refresh) ;; # The previous refresh spelling now just regenerates local files.
  *) echo "Usage: $0 [--refresh]" >&2; exit 2 ;;
esac
command -v python3 >/dev/null 2>&1 || { echo "python3 is required" >&2; exit 127; }
python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' || {
  echo "Python 3.11 or newer is required" >&2; exit 2;
}
if [[ ! -f "$ROOT/.env" ]]; then
  (umask 077; cp "$ROOT/.env.example" "$ROOT/.env")
fi
python3 -B "$ROOT/scripts/configure-local"
bash "$ROOT/scripts/user-link" install oc
bash "$ROOT/scripts/user-link" install oc2
printf '\nInstalled native oc and oc2. Run either from your project directory.\n'
printf 'No Docker, npm install, pip install, background server or auth migration was run.\n'
for binary in opencode opencode2; do
  command -v "$binary" >/dev/null 2>&1 || printf 'Missing optional runtime: %s (install it before using its launcher).\n' "$binary"
done
