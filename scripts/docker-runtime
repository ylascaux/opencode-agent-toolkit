#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

[[ -f "$ROOT/.env" ]] || {
  echo "Missing $ROOT/.env. Run: just install" >&2
  exit 1
}

set -a
source "$ROOT/.env"
[[ -f "$ROOT/.env.local" ]] && source "$ROOT/.env.local"
set +a

command -v docker >/dev/null 2>&1 || { echo "Docker is required" >&2; exit 127; }
docker compose version >/dev/null 2>&1 || { echo "Docker Compose v2 is required" >&2; exit 127; }
docker info >/dev/null 2>&1 || { echo "Docker daemon is not reachable" >&2; exit 3; }

service=oc-server
host_port="${OAT_OC_PORT:-4096}"
cwd="$(pwd -P)"
workspace_root="${OAT_WORKSPACE_ROOT:-$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "$cwd")}"
workspace_root="$(cd "$workspace_root" && pwd -P)"

case "$cwd/" in
  "$workspace_root/"*) ;;
  *) echo "Current directory is outside OAT_WORKSPACE_ROOT: $workspace_root" >&2; exit 2 ;;
esac

export OAT_WORKSPACE_ROOT="$workspace_root"
export OAT_RUNTIME_IMAGE="${OAT_RUNTIME_IMAGE:-opencode-agent-toolkit:local}"
compose=(docker compose --project-directory "$ROOT" -f "$ROOT/compose.yaml")

ensure_server() {
  if ! docker image inspect "$OAT_RUNTIME_IMAGE" >/dev/null 2>&1; then
    echo "Runtime image missing; building $OAT_RUNTIME_IMAGE" >&2
    "${compose[@]}" build "$service"
  fi
  "${compose[@]}" up -d "$service" >/dev/null

  local cid health
  cid="$("${compose[@]}" ps -q "$service")"
  [[ -n "$cid" ]] || { echo "Failed to start $service" >&2; exit 3; }
  for _ in {1..30}; do
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || true)"
    case "$health" in
      healthy|running) return 0 ;;
      unhealthy|exited|dead)
        "${compose[@]}" logs --tail=80 docker-agent "$service" >&2 || true
        exit 3
        ;;
    esac
    sleep 1
  done
  echo "Timed out waiting for $service" >&2
  exit 3
}

import_host_auth() {
  [[ "${OAT_IMPORT_HOST_AUTH:-1}" == "1" ]] || return 0
  local host_auth cid
  host_auth="${OAT_HOST_AUTH_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json}"
  [[ -f "$host_auth" ]] || return 0
  if "${compose[@]}" exec -T "$service" test -s /root/.local/share/opencode/auth.json >/dev/null 2>&1; then
    return 0
  fi
  cid="$("${compose[@]}" ps -q "$service")"
  docker exec "$cid" mkdir -p /root/.local/share/opencode
  docker cp "$host_auth" "$cid:/root/.local/share/opencode/auth.json" >/dev/null
  docker exec "$cid" chmod 600 /root/.local/share/opencode/auth.json
  "${compose[@]}" restart "$service" >/dev/null
  ensure_server
}

if [[ "${1:-}" == "server" || "${1:-}" == "serve" ]]; then
  action="${2:-status}"
  case "$action" in
    status)
      ensure_server
      import_host_auth
      "${compose[@]}" ps docker-agent "$service"
      printf 'OpenCode server: http://127.0.0.1:%s\n' "$host_port"
      ;;
    logs)
      ensure_server
      exec "${compose[@]}" logs -f docker-agent "$service"
      ;;
    stop|down)
      "${compose[@]}" stop "$service"
      ;;
    restart)
      "${compose[@]}" up -d --force-recreate "$service" >/dev/null
      ensure_server
      import_host_auth
      ;;
    *) echo "Usage: oc server {status|logs|stop|restart}" >&2; exit 2 ;;
  esac
  exit 0
fi

ensure_server
import_host_auth

exec_opts=()
[[ -t 1 ]] || exec_opts+=(-T)

if [[ "${1:-}" == "shell" ]]; then
  shift
  exec "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service" bash "$@"
fi

native_bin="${OAT_OC_NATIVE_BIN:-opencode}"
client_mode="${OAT_OC_CLIENT_MODE:-auto}"
case "$client_mode" in auto|native|container) ;; *) echo "OAT_OC_CLIENT_MODE must be auto, native, or container" >&2; exit 2 ;; esac

use_native=0
if [[ "$client_mode" != "container" ]] && command -v "$native_bin" >/dev/null 2>&1; then
  host_version="$("$native_bin" --version 2>/dev/null | head -n 1 || true)"
  server_version="$("${compose[@]}" exec -T "$service" opencode --version 2>/dev/null | head -n 1 || true)"
  if [[ -n "$host_version" && "$host_version" == "$server_version" ]]; then
    use_native=1
  elif [[ "$client_mode" == "native" ]]; then
    echo "Native OpenCode version does not match Docker server: host=$host_version server=$server_version" >&2
    exit 3
  fi
elif [[ "$client_mode" == "native" ]]; then
  echo "Native OpenCode client not found: $native_bin" >&2
  exit 127
fi

if [[ "$use_native" == 1 ]]; then
  exec "$native_bin" --server "http://127.0.0.1:$host_port" "$@"
fi

exec "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service"   opencode --server http://127.0.0.1:4096 "$@"
