#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
REQUESTED_MAJOR="${OPENCODE_MAJOR:-}"

[[ -f "$ROOT/.env" ]] || {
  echo "Missing $ROOT/.env. Run: just install" >&2
  exit 1
}

set -a
source "$ROOT/.env"
[[ -f "$ROOT/.env.local" ]] && source "$ROOT/.env.local"
set +a

# The launcher may have selected V2 explicitly (notably via the `oc2` symlink).
# Preserve that caller-owned choice across .env loading; .env only supplies a
# default when no explicit OPENCODE_MAJOR was inherited.
if [[ -n "$REQUESTED_MAJOR" ]]; then
  OPENCODE_MAJOR="$REQUESTED_MAJOR"
fi
export OPENCODE_MAJOR

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required for the container runtime" >&2
  exit 127
fi
if ! docker compose version >/dev/null 2>&1; then
  echo "Docker Compose v2 is required (docker compose)" >&2
  exit 127
fi
if ! docker info >/dev/null 2>&1; then
  echo "Docker daemon is not reachable from the host" >&2
  exit 3
fi

major="${OPENCODE_MAJOR:-1}"
[[ "$major" == auto ]] && major=2
case "$major" in
  1)
    service=oc-server
    bin=opencode
    host_port="${OAT_OC_PORT:-4095}"
    ;;
  2)
    service=oc2-server
    bin=opencode2
    host_port="${OAT_OC2_PORT:-4096}"
    ;;
  *)
    echo "OPENCODE_MAJOR must be 1, 2, or auto for the Docker runtime (got: $major)" >&2
    exit 2
    ;;
esac

ensure_v2_server_password() {
  [[ "$major" == "2" ]] || return 0
  [[ -n "${OPENCODE_SERVER_PASSWORD:-}" ]] && return 0

  local secret env_local
  env_local="$ROOT/.env.local"
  secret="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  [[ ${#secret} -eq 64 ]] || {
    echo "Failed to generate OPENCODE_SERVER_PASSWORD" >&2
    exit 3
  }
  touch "$env_local"
  chmod 600 "$env_local" 2>/dev/null || true
  printf '\n# Generated by scripts/docker-runtime for the local OC2 server.\nOPENCODE_SERVER_PASSWORD=%s\n' "$secret" >> "$env_local"
  export OPENCODE_SERVER_PASSWORD="$secret"
  echo "Generated a local OPENCODE_SERVER_PASSWORD in .env.local" >&2
}

ensure_v2_server_password

cwd="$(pwd -P)"
if [[ -n "${OAT_WORKSPACE_ROOT:-}" ]]; then
  if [[ ! -d "$OAT_WORKSPACE_ROOT" ]]; then
    echo "OAT_WORKSPACE_ROOT does not exist: $OAT_WORKSPACE_ROOT" >&2
    exit 2
  fi
  workspace_root="$(cd "$OAT_WORKSPACE_ROOT" && pwd -P)"
else
  workspace_root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "$cwd")"
  workspace_root="$(cd "$workspace_root" && pwd -P)"
fi

case "$cwd/" in
  "$workspace_root/"*) ;;
  *)
    echo "Current directory is outside OAT_WORKSPACE_ROOT:" >&2
    echo "  cwd:       $cwd" >&2
    echo "  workspace: $workspace_root" >&2
    exit 2
    ;;
esac

# Persistent toolkit-owned data/state is shared by normal OC/OC2 sessions while
# the rest of the host home remains outside the runtime. Docker itself is now a
# dedicated DinD service and the host Docker socket is never mounted in OC/OC2.
data_dir="${OAT_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode-agent-toolkit}"
state_dir="${OAT_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/opencode-agent-toolkit}"
mkdir -p "$data_dir" "$state_dir"
data_dir="$(cd "$data_dir" && pwd -P)"
state_dir="$(cd "$state_dir" && pwd -P)"

# Mutable runtime settings changed from inside the container (currently memory
# enable/capture settings) live in the already-shared state directory, not in the
# immutable /opt/oat image filesystem and not in .env.local where secrets live.
runtime_env="$state_dir/runtime.env"
touch "$runtime_env"
chmod 600 "$runtime_env" 2>/dev/null || true
set -a
source "$runtime_env"
set +a

export OAT_WORKSPACE_ROOT="$workspace_root"
export OAT_DATA_DIR="$data_dir"
export OAT_STATE_DIR="$state_dir"
export OAT_RUNTIME_ENV_FILE_HOST="$runtime_env"
export OAT_RUNTIME_IMAGE="${OAT_RUNTIME_IMAGE:-opencode-agent-toolkit:local}"

compose=(docker compose --project-directory "$ROOT" -f "$ROOT/compose.yaml")

ensure_server() {
  if ! docker image inspect "$OAT_RUNTIME_IMAGE" >/dev/null 2>&1; then
    echo "Runtime image missing; building $OAT_RUNTIME_IMAGE" >&2
    "${compose[@]}" build "$service"
  fi

  # depends_on starts docker-agent first and waits for its healthcheck.
  "${compose[@]}" up -d "$service" >/dev/null

  local cid health i
  cid="$("${compose[@]}" ps -q "$service")"
  [[ -n "$cid" ]] || {
    echo "Failed to start $service" >&2
    "${compose[@]}" logs --tail=80 docker-agent "$service" >&2 || true
    exit 3
  }

  for i in {1..30}; do
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || true)"
    case "$health" in
      healthy|running) return 0 ;;
      unhealthy|exited|dead)
        echo "$service failed to become healthy (state: $health)" >&2
        "${compose[@]}" logs --tail=80 docker-agent "$service" >&2 || true
        exit 3
        ;;
    esac
    sleep 1
  done

  echo "Timed out waiting for $service" >&2
  "${compose[@]}" logs --tail=80 docker-agent "$service" >&2 || true
  exit 3
}

# Preserve an existing local OpenCode login without mounting the whole host home.
# The import is one-time per V1/V2 home volume and can be disabled explicitly.
import_host_auth() {
  [[ "${OAT_IMPORT_HOST_AUTH:-1}" == "1" ]] || return 0

  local host_auth cid
  host_auth="${OAT_HOST_AUTH_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json}"
  [[ -f "$host_auth" ]] || return 0

  if "${compose[@]}" exec -T "$service" test -s /root/.local/share/opencode/auth.json >/dev/null 2>&1; then
    return 0
  fi

  cid="$("${compose[@]}" ps -q "$service")"
  [[ -n "$cid" ]] || return 0
  docker exec "$cid" mkdir -p /root/.local/share/opencode
  docker cp "$host_auth" "$cid:/root/.local/share/opencode/auth.json" >/dev/null
  docker exec "$cid" chmod 600 /root/.local/share/opencode/auth.json
  echo "Imported existing host OpenCode auth into the persistent $service volume" >&2

  # The server may cache provider credentials at startup. Restart only on this
  # first import so credentials are guaranteed to be visible to the server.
  "${compose[@]}" restart "$service" >/dev/null
  ensure_server
}

server_control() {
  local action="${1:-status}"
  case "$action" in
    status)
      ensure_server
      import_host_auth
      "${compose[@]}" ps docker-agent "$service"
      printf '%s server: http://127.0.0.1:%s\n' "$bin" "$host_port"
      printf 'Docker: dedicated DinD service (host docker.sock not mounted)\n'
      ;;
    logs)
      ensure_server
      import_host_auth
      exec "${compose[@]}" logs -f docker-agent "$service"
      ;;
    stop|down)
      "${compose[@]}" stop "$service"
      ;;
    restart)
      "${compose[@]}" up -d --force-recreate "$service" >/dev/null
      ensure_server
      import_host_auth
      ;;
    *)
      echo "Usage: $bin server {status|logs|stop|restart}" >&2
      exit 2
      ;;
  esac
}

if [[ "${1:-}" == "server" || "${1:-}" == "serve" ]]; then
  shift || true
  server_control "${1:-status}"
  exit $?
fi

ensure_server
import_host_auth

exec_opts=()
if [[ ! -t 1 ]]; then
  exec_opts+=(-T)
fi

run_preflight() {
  [[ "${OPENCODE_PREFLIGHT:-1}" == "1" ]] || return 0
  "${compose[@]}" exec -T -w "$cwd" "$service" bash /opt/oat/scripts/preflight
}

if [[ "${1:-}" == "shell" ]]; then
  shift
  exec "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service" bash "$@"
fi

restart_memory_consumers() {
  local target cid
  for target in oc-server oc2-server; do
    cid="$("${compose[@]}" ps -q "$target" 2>/dev/null || true)"
    [[ -n "$cid" ]] || continue
    echo "Reloading $target after memory configuration change" >&2
    "${compose[@]}" up -d --force-recreate "$target" >/dev/null
  done
}

# Memory is toolkit-global rather than an OpenCode CLI command. It runs inside
# the selected service while data/candidates persist in the shared toolkit dirs.
# Configuration-changing commands write the shared runtime.env and force running
# servers to reload it so V2 capture actually becomes active immediately.
if [[ "${1:-}" == "memory" ]]; then
  shift
  if [[ $# -eq 0 ]]; then
    set -- --help
  fi
  memory_action="${1:-}"
  set +e
  "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service" \
    python3 /opt/oat/scripts/memory "$@"
  memory_status=$?
  set -e
  if [[ $memory_status -eq 0 ]]; then
    case "$memory_action" in
      enable|disable|capture-on|capture-off) restart_memory_consumers ;;
    esac
  fi
  exit "$memory_status"
fi

if [[ "$major" == "1" ]]; then
  if [[ $# -eq 0 ]]; then
    run_preflight
    exec "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service" \
      opencode attach http://127.0.0.1:4096 --dir "$cwd"
  fi

  if [[ "$1" == "run" ]]; then
    shift
    run_preflight
    exec "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service" \
      opencode run --attach http://127.0.0.1:4096 --dir "$cwd" "$@"
  fi

  exec "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service" opencode "$@"
fi

# Authentication is local credential state rather than a server RPC. Execute it
# directly in the persistent V2 home volume so credentials survive server restarts.
# OpenAI browser OAuth binds its callback to the container loopback, so provide a
# dedicated shortcut that always uses OpenCode's device/headless flow instead.
if [[ "${1:-}" == "auth" ]]; then
  if [[ "${2:-}" == "openai" ]]; then
    if [[ $# -ne 2 ]]; then
      echo "Usage: oc2 auth openai" >&2
      exit 2
    fi
    exec "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service" \
      opencode2 auth login -p openai -m "ChatGPT Pro/Plus (headless)"
  fi

  if [[ "${2:-}" == "login" && $# -eq 2 ]]; then
    cat >&2 <<'EOF'
OC2 runs inside Docker. OpenAI's browser OAuth callback binds to the container loopback
and cannot be reached through a normal Docker port publish.
For ChatGPT Pro/Plus use: oc2 auth openai
If you continue with the interactive provider picker, choose "ChatGPT Pro/Plus (headless)".
EOF
  fi

  exec "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service" opencode2 "$@"
fi

# The TUI is where host clipboard/browser integration belongs. Prefer a native
# V2 client when it is installed and exactly matches the server version, while
# keeping the server, tools, credentials and agent execution inside Docker.
use_native_v2=0
native_v2_bin="${OAT_OC2_NATIVE_BIN:-opencode2}"
client_mode="${OAT_OC2_CLIENT_MODE:-auto}"
case "$client_mode" in
  auto|native|container) ;;
  *)
    echo "OAT_OC2_CLIENT_MODE must be auto, native, or container (got: $client_mode)" >&2
    exit 2
    ;;
esac

if [[ "$client_mode" != "container" ]]; then
  if command -v "$native_v2_bin" >/dev/null 2>&1; then
    host_version="$($native_v2_bin --version 2>/dev/null | head -n 1 || true)"
    server_version="$("${compose[@]}" exec -T "$service" opencode2 --version 2>/dev/null | head -n 1 || true)"
    if [[ -n "$host_version" && "$host_version" == "$server_version" ]]; then
      use_native_v2=1
    elif [[ "$client_mode" == "native" ]]; then
      echo "Native opencode2 version does not match Docker server: host=$host_version server=$server_version" >&2
      exit 3
    else
      echo "Native opencode2 version mismatch; falling back to container TUI (host=$host_version server=$server_version)" >&2
    fi
  elif [[ "$client_mode" == "native" ]]; then
    echo "Native OpenCode V2 client not found: $native_v2_bin" >&2
    echo "Install the matching @opencode/cli version or set OAT_OC2_CLIENT_MODE=container" >&2
    exit 127
  fi
fi

if [[ "$use_native_v2" == "1" ]]; then
  if [[ $# -eq 0 || "${1:-}" == "run" ]]; then
    run_preflight
  fi
  exec "$native_v2_bin" --server "http://127.0.0.1:$host_port" "$@"
fi

# Container TUI fallback preserves the zero-host-install workflow, but native
# clipboard integration is intentionally unavailable in this mode.
if [[ $# -eq 0 ]]; then
  run_preflight
  exec "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service" \
    opencode2 --server http://127.0.0.1:4096
fi

if [[ "$1" == "run" ]]; then
  run_preflight
fi
exec "${compose[@]}" exec "${exec_opts[@]}" -w "$cwd" "$service" \
  opencode2 --server http://127.0.0.1:4096 "$@"
