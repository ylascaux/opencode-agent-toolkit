#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

from memory_plugin import PluginSettings, cli_command, ensure_plugin

ROOT = Path(__file__).resolve().parents[1]
TRUTHY = {"1", "true", "yes", "on"}


def _enabled(name: str) -> bool:
    return os.getenv(name, "").strip().lower() in TRUTHY


def _settings_path() -> Path:
    runtime_path = os.getenv("OAT_RUNTIME_ENV_FILE", "").strip()
    if os.getenv("OAT_RUNTIME", "").strip().lower() == "container" and runtime_path:
        return Path(runtime_path).expanduser()
    return ROOT / ".env.local"


def _write_env_local(updates: dict[str, str]) -> None:
    path = _settings_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = path.read_text().splitlines() if path.exists() else []
    pending = dict(updates)
    output: list[str] = []
    for line in lines:
        match = re.match(r"^\s*([A-Z0-9_]+)=", line)
        if match and match.group(1) in pending:
            key = match.group(1)
            output.append(f"{key}={shlex.quote(pending.pop(key))}")
        else:
            output.append(line)
    if output and output[-1].strip():
        output.append("")
    for key, value in pending.items():
        output.append(f"{key}={shlex.quote(value)}")
    path.write_text("\n".join(output).rstrip() + "\n")
    try:
        path.chmod(0o600)
    except OSError:
        pass


def _apply_updates(updates: dict[str, str]) -> None:
    _write_env_local(updates)
    os.environ.update(updates)


def _run_plugin(*args: str, force_sync: bool = False) -> int:
    command = cli_command(*args, force_sync=force_sync)
    result = subprocess.run(command, env=os.environ.copy(), check=False)
    return result.returncode


def cmd_enable(args: argparse.Namespace) -> int:
    repo = (args.repo or os.getenv("OAT_MEMORY_REPO", "")).strip()
    if not repo:
        print(
            "Memory repository is not configured. Run: oc2 memory enable git@github.com:USER/opencode-memory.git",
            file=os.sys.stderr,
        )
        return 2
    updates = {"OAT_MEMORY_ENABLED": "1", "OAT_MEMORY_REPO": repo}
    _apply_updates(updates)
    ensure_plugin(force_sync=True)
    return _run_plugin("status")


def cmd_disable(_args: argparse.Namespace) -> int:
    _apply_updates({"OAT_MEMORY_ENABLED": "0"})
    print("memory=off")
    print(f"capture={'on' if _enabled('OAT_MEMORY_CAPTURE_ENABLED') else 'off'}")
    print("effective_capture=off")
    return 0


def cmd_status(_args: argparse.Namespace) -> int:
    settings = PluginSettings.from_env()
    memory_enabled = _enabled("OAT_MEMORY_ENABLED")
    capture_enabled = _enabled("OAT_MEMORY_CAPTURE_ENABLED")
    print(f"plugin_repo={settings.repo}")
    print(f"plugin_ref={settings.ref}")
    print(f"plugin_dir={settings.directory}")
    print(f"settings_file={_settings_path()}")
    print(f"memory={'on' if memory_enabled else 'off'}")
    print(f"capture={'on' if capture_enabled else 'off'}")
    print(f"effective_capture={'on' if memory_enabled and capture_enabled else 'off'}")
    memory_repo = os.getenv("OAT_MEMORY_REPO", "").strip()
    if memory_repo:
        print(f"memory_repo={memory_repo}")
    if not memory_enabled:
        return 0
    return _run_plugin("status")


def cmd_sync(_args: argparse.Namespace) -> int:
    ensure_plugin(force_sync=True)
    return _run_plugin("sync")


def cmd_show(args: argparse.Namespace) -> int:
    values = ["render", "--agent", args.agent, "--cwd", str(Path.cwd())]
    if args.json:
        values.append("--json")
    return _run_plugin(*values)


def cmd_capture_on(_args: argparse.Namespace) -> int:
    updates = {"OAT_MEMORY_CAPTURE_ENABLED": "1"}
    auto_enabled = False
    if not _enabled("OAT_MEMORY_ENABLED"):
        repo = os.getenv("OAT_MEMORY_REPO", "").strip()
        if not repo:
            print(
                "Cannot enable memory capture while memory is disabled and OAT_MEMORY_REPO is not configured.",
                file=os.sys.stderr,
            )
            print(
                "Run: oc2 memory enable git@github.com:USER/opencode-memory.git",
                file=os.sys.stderr,
            )
            return 2
        updates["OAT_MEMORY_ENABLED"] = "1"
        auto_enabled = True
    _apply_updates(updates)
    if auto_enabled:
        ensure_plugin(force_sync=True)
        print("memory=on (auto-enabled for capture)")
    print("memory_capture=on")
    print("effective_capture=on")
    return 0


def cmd_capture_off(_args: argparse.Namespace) -> int:
    _apply_updates({"OAT_MEMORY_CAPTURE_ENABLED": "0"})
    print("memory_capture=off")
    print("effective_capture=off")
    return 0


def cmd_candidates(args: argparse.Namespace) -> int:
    values = ["candidates"]
    if args.all:
        values.append("--all")
    if args.status:
        values.extend(["--status", args.status])
    if args.json:
        values.append("--json")
    return _run_plugin(*values)


def cmd_candidate(args: argparse.Namespace) -> int:
    return _run_plugin("show", args.id)


def cmd_reject(args: argparse.Namespace) -> int:
    return _run_plugin("reject", args.id)


def cmd_accept(args: argparse.Namespace) -> int:
    values = ["accept", args.id]
    if args.push:
        values.append("--push")
    return _run_plugin(*values)


def cmd_promote(args: argparse.Namespace) -> int:
    values = ["promote", args.id]
    if args.target:
        values.extend(["--target", args.target])
    if args.push:
        values.append("--push")
    return _run_plugin(*values)


def cmd_push(_args: argparse.Namespace) -> int:
    return _run_plugin("push")


def cmd_add(args: argparse.Namespace) -> int:
    values = ["add", args.kind, args.title, args.statement]
    if args.target:
        values.extend(["--target", args.target])
    if args.project:
        values.extend(["--project", args.project])
    if args.confidence:
        values.extend(["--confidence", args.confidence])
    if args.rationale:
        values.extend(["--rationale", args.rationale])
    return _run_plugin(*values)


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Manage the external OpenCode memory plugin from the toolkit.")
    sub = result.add_subparsers(dest="command", required=True)

    enable = sub.add_parser("enable", help="enable memory and optionally configure its Git data repository")
    enable.add_argument("repo", nargs="?", default="")
    enable.set_defaults(func=cmd_enable)

    disable = sub.add_parser("disable", help="disable memory")
    disable.set_defaults(func=cmd_disable)
    status = sub.add_parser("status", help="show toolkit/plugin memory status")
    status.set_defaults(func=cmd_status)
    mcp = sub.add_parser("mcp", help="start local MCP from the prebuilt plugin (exported environment only)")
    mcp.add_argument("--cwd", default=None)
    sync = sub.add_parser("sync", help="force plugin + memory-vault synchronization")
    sync.set_defaults(func=cmd_sync)

    show = sub.add_parser("show", help="render the memory context for an agent")
    show.add_argument("agent", nargs="?", default="orchestrator")
    show.add_argument("--json", action="store_true")
    show.set_defaults(func=cmd_show)

    capture_on = sub.add_parser("capture-on", help="enable automatic V1/V2 memory candidate capture")
    capture_on.set_defaults(func=cmd_capture_on)
    capture_off = sub.add_parser("capture-off", help="disable automatic memory candidate capture")
    capture_off.set_defaults(func=cmd_capture_off)

    candidates = sub.add_parser("candidates", help="list memory candidates")
    candidates.add_argument("--all", action="store_true")
    candidates.add_argument("--status", default="")
    candidates.add_argument("--json", action="store_true")
    candidates.set_defaults(func=cmd_candidates)

    candidate = sub.add_parser("candidate", help="show a memory candidate")
    candidate.add_argument("id")
    candidate.set_defaults(func=cmd_candidate)

    reject = sub.add_parser("reject", help="reject a pending local candidate")
    reject.add_argument("id")
    reject.set_defaults(func=cmd_reject)

    accept = sub.add_parser("accept", help="accept a pending candidate into the inactive Git inbox")
    accept.add_argument("id")
    accept.add_argument("--push", action="store_true")
    accept.set_defaults(func=cmd_accept)

    promote = sub.add_parser("promote", help="promote an accepted candidate into active durable memory")
    promote.add_argument("id")
    promote.add_argument("--target", default="")
    promote.add_argument("--push", action="store_true")
    promote.set_defaults(func=cmd_promote)

    push = sub.add_parser("push", help="push local memory-vault commits")
    push.set_defaults(func=cmd_push)

    add = sub.add_parser("add", help="create a memory candidate manually")
    add.add_argument("kind")
    add.add_argument("title")
    add.add_argument("statement")
    add.add_argument("--target", default="")
    add.add_argument("--project", default="")
    add.add_argument("--confidence", choices=("medium", "high"), default="high")
    add.add_argument("--rationale", default="")
    add.set_defaults(func=cmd_add)
    return result


def main() -> int:
    if sys.argv[1:2] == ["mcp"]:
        os.execv(sys.executable, [sys.executable, "-B", str(ROOT / "scripts" / "memory-mcp"), *sys.argv[2:]])
    args = parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
