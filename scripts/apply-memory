#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
from pathlib import Path

from memory_plugin import ensure_plugin

ROOT = Path(__file__).resolve().parents[1]
PROMPTS_V2 = ROOT / ".generated" / "prompts"
V2_PLUGIN_DIR = ROOT / ".generated" / "plugins" / "opencode-memory-plugin-v2"
V2_PLUGIN_ENTRY = V2_PLUGIN_DIR / "index.js"
V2_PLUGIN_PACKAGE = V2_PLUGIN_DIR / "package.json"
MARKER = "## Opt-in long-term memory"
TRUTHY = {"1", "true", "yes", "on"}


def enabled(name: str, default: bool = False) -> bool:
    raw = os.getenv(name)
    if raw is None or not raw.strip():
        return default
    return raw.strip().lower() in TRUTHY


def clean_previous_memory() -> None:
    for prompt_path in PROMPTS_V2.glob("*.md"):
        text = prompt_path.read_text()
        if MARKER in text:
            prompt_path.write_text(text[: text.index(MARKER)].rstrip() + "\n")


def remove_v2_plugin_wrapper() -> None:
    for path in (V2_PLUGIN_ENTRY, V2_PLUGIN_PACKAGE):
        if path.is_file():
            path.unlink()
    if V2_PLUGIN_DIR.is_dir():
        try:
            V2_PLUGIN_DIR.rmdir()
        except OSError:
            print(
                f"OpenCode memory plugin: preserving unexpected content in {V2_PLUGIN_DIR}",
                file=os.sys.stderr,
            )


def prepare_v2_plugin_wrapper(plugin_entry: Path) -> str:
    """Expose a directory entrypoint for V2 builds that reject plugin files."""
    V2_PLUGIN_DIR.mkdir(parents=True, exist_ok=True)
    module_uri = plugin_entry.resolve().as_uri()
    V2_PLUGIN_ENTRY.write_text(
        "// Generated by scripts/apply-memory; do not edit.\n"
        f"export {{ default }} from {json.dumps(module_uri)}\n"
    )
    V2_PLUGIN_PACKAGE.write_text('{"type":"module"}\n')
    return str(V2_PLUGIN_DIR.resolve())


def configure_plugin(v1_path: str | None, v2_path: str | None) -> None:
    v1_config = ROOT / "opencode.jsonc"
    v2_config = ROOT / "opencode.v2.jsonc"
    v1 = json.loads(v1_config.read_text())
    v2 = json.loads(v2_config.read_text())

    v1_plugins = v1.setdefault("plugin", [])
    v1_plugins[:] = [value for value in v1_plugins if "opencode-memory-plugin" not in str(value)]
    v2_plugins = v2.setdefault("plugins", [])
    v2_plugins[:] = [value for value in v2_plugins if "opencode-memory-plugin" not in str(value)]
    if v1_path:
        v1_plugins.append(v1_path)
    if v2_path:
        v2_plugins.append(v2_path)
    v1_config.write_text(json.dumps(v1, indent=2) + "\n")
    v2_config.write_text(json.dumps(v2, indent=2) + "\n")


def render_for_agent(cli: Path, agent: str) -> str:
    result = subprocess.run(
        ["node", str(cli), "render", "--agent", agent, "--cwd", str(Path.cwd())],
        env=os.environ.copy(),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=30,
        check=False,
    )
    if result.returncode != 0:
        raise SystemExit(f"OpenCode memory render failed for {agent}: {result.stderr.strip() or result.stdout.strip()}")
    return result.stdout.strip()


def main() -> int:
    clean_previous_memory()
    if not enabled("OAT_MEMORY_ENABLED", False):
        configure_plugin(None, None)
        remove_v2_plugin_wrapper()
        print("memory disabled")
        return 0

    plugin = ensure_plugin()
    v1_path = str((plugin / "dist" / "v1.js").resolve())
    v2_path = prepare_v2_plugin_wrapper(plugin / "dist" / "v2.js")
    configure_plugin(v1_path, v2_path)

    updated = 0
    # V1 injects through experimental.chat.system.transform. V2 currently has
    # no equivalent hook, so the toolkit consumes the plugin's stable renderer.
    for prompt_path in sorted(PROMPTS_V2.glob("*.md")):
        context = render_for_agent(plugin / "dist" / "cli.js", prompt_path.stem)
        if not context:
            continue
        prompt_path.write_text(prompt_path.read_text().rstrip() + "\n\n" + context + "\n")
        updated += 1

    print(f"memory plugin applied: v1=runtime v2=rendered prompts={updated} plugin={plugin}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
