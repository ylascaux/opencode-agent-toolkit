#!/usr/bin/env python3
from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
ENV_LOCAL = ROOT / ".env.local"
KEY = "OAT_SANDBOX_ENABLED"


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in {"on", "off"}:
        print("usage: sandbox-toggle on|off", file=sys.stderr)
        return 2
    value = "1" if sys.argv[1] == "on" else "0"
    text = ENV_LOCAL.read_text() if ENV_LOCAL.exists() else ""
    pattern = re.compile(rf"(?m)^{re.escape(KEY)}=.*$")
    replacement = f"{KEY}={value}"
    if pattern.search(text):
        text = pattern.sub(replacement, text)
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += replacement + "\n"
    ENV_LOCAL.write_text(text)
    print(f"{KEY}={value} in .env.local")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
