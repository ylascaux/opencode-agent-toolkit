#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

command -v python3 >/dev/null 2>&1 || { echo "Missing Python 3.11+" >&2; exit 127; }
python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' || {
  echo "Python 3.11 or newer is required" >&2; exit 2;
}

bin="${OPENCODE_BIN:-opencode}"
command -v "$bin" >/dev/null 2>&1 || {
  echo "OpenCode 2 is not installed. Run: just install" >&2
  exit 1
}
version="$("$bin" --version 2>/dev/null | head -n 1 || true)"
printf 'opencode: %s (%s)\n' "$(command -v "$bin")" "${version:-unknown}"
[[ "$version" =~ ^2\. ]] || {
  echo "OpenCode 2 is required; remove opencode-ai and install @opencode/cli." >&2
  exit 1
}

python3 -B "$ROOT/scripts/configure-local" --check || {
  echo "OpenCode configuration needs regeneration: just config" >&2
  exit 1
}

echo "Plugins:"
"$bin" plugin list || true
echo "Stable OpenCode 2 configuration is up to date."
