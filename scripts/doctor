#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command -v python3 >/dev/null 2>&1 || { echo "Missing Python 3.11+" >&2; exit 127; }
python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' || {
  echo "Python 3.11 or newer is required" >&2; exit 2;
}
if command -v opencode >/dev/null 2>&1; then
  printf 'opencode: %s\n' "$(command -v opencode)"
  printf 'version: %s\n' "$(opencode --version 2>/dev/null || echo unknown)"
else
  echo "OpenCode 2 is not installed. Run: just install" >&2
  exit 1
fi
python3 -B "$ROOT/scripts/configure-local" --check || {
  echo "OpenCode configuration needs regeneration: just config" >&2
  exit 1
}

set -a
if [[ -f "$ROOT/.env" ]]; then
  source "$ROOT/.env"
elif [[ -f "$ROOT/.env.example" ]]; then
  source "$ROOT/.env.example"
fi
[[ ! -f "$ROOT/.env.local" ]] || source "$ROOT/.env.local"
set +a

case "${OAT_AI_MEMORY_ENABLED:-1}" in
  0|false|FALSE|no|NO|off|OFF)
    echo "AI memory: disabled"
    ;;
  *)
    memory_home="${OAT_AI_MEMORY_HOME:-$HOME/.local/share/opencode-agent-toolkit/vendor/ai-memory/node_modules/create-ai-memory}"
    memory_root="${OAT_AI_MEMORY_ROOT:-$HOME/opencode-memory}"
    if [[ ! -f "$memory_home/shell/ai-mem.zsh" ]]; then
      echo "AI memory package missing: run just install" >&2
      exit 1
    fi
    if [[ ! -d "$memory_root" ]]; then
      echo "AI memory vault missing: $memory_root" >&2
      exit 1
    fi
    python3 -B "$ROOT/scripts/ai-memory-adapter" doctor --home "$memory_home" --root "$memory_root" --cwd "$PWD"
    ;;
esac

echo "OpenCode 2 configuration is up to date."
