#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command -v python3 >/dev/null 2>&1 || { echo "Missing Python 3.11+" >&2; exit 127; }
python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' || {
  echo "Python 3.11 or newer is required" >&2; exit 2;
}
if command -v opencode >/dev/null 2>&1; then
  printf 'opencode: %s\n' "$(command -v opencode)"
  printf 'version: %s\n' "$(opencode --version 2>/dev/null || echo unknown)"
else
  echo "OpenCode 2 is not installed. Run: just install" >&2
  exit 1
fi
python3 -B "$ROOT/scripts/configure-local" --check || {
  echo "OpenCode configuration needs regeneration: just config" >&2
  exit 1
}

set -a
if [[ -f "$ROOT/.env" ]]; then
  source "$ROOT/.env"
elif [[ -f "$ROOT/.env.example" ]]; then
  source "$ROOT/.env.example"
fi
[[ ! -f "$ROOT/.env.local" ]] || source "$ROOT/.env.local"
set +a

python3 -B "$ROOT/scripts/acp-runner" doctor "${OAT_ACP_DEFAULT_RUNNER:-opencode}" || {
  echo "ACP runner is not ready. Check OAT_ACP_DEFAULT_RUNNER / OPENCODE_BIN." >&2
  exit 1
}

case "${OAT_MEMORY_ENABLED:-1}" in
  0|false|FALSE|no|NO|off|OFF)
    echo "Memory: disabled"
    ;;
  *)
    memory_root="${OAT_MEMORY_DIR:-$HOME/opencode-memory}"
    data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    plugin_dir="${OAT_MEMORY_PLUGIN_DIR:-$data_home/opencode-agent-toolkit/plugins/opencode-memory-plugin}"
    [[ -d "$memory_root" ]] || { echo "Memory vault missing: $memory_root" >&2; exit 1; }
    [[ -f "$plugin_dir/dist/v2.js" && -f "$plugin_dir/dist/cli.js" ]] || {
      echo "Memory plugin missing or incomplete: run just install" >&2
      exit 1
    }
    OAT_MEMORY_AUTO_SYNC=0 python3 -B "$ROOT/scripts/memory" status
    ;;
esac

echo "OpenCode 2 configuration is up to date."
