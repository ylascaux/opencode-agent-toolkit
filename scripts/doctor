#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
status=0
printf 'Native toolkit diagnostics (no server/provider calls)\n'
for binary in python3 opencode opencode2; do
  if path="$(command -v "$binary")"; then
    printf '%-12s %s\n' "$binary" "$path"
  else
    printf '%-12s not found\n' "$binary"
    status=1
  fi
done
bash "$ROOT/scripts/user-link" status oc || status=1
bash "$ROOT/scripts/user-link" status oc2 || status=1
printf '\nProvider authentication: oc auth login / oc2 auth login\n'
printf 'Memory is optional: oc memory status | Codex: oc codex doctor\n'
printf 'No Docker, Nix, sandbox or background daemon is required.\n'
exit "$status"
