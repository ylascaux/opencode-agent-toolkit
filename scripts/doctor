#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

ok=1
check_cmd() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    printf '[ok]   %-12s %s\n' "$name" "$(command -v "$name")"
  else
    printf '[warn] %-12s not found\n' "$name"
  fi
}

printf 'OpenCode Agent Toolkit doctor\n\n'

if [[ -f .env ]]; then
  echo "[ok]   .env         present"
  set -a
  source .env
  [[ -f .env.local ]] && source .env.local
  set +a
else
  echo "[fail] .env         missing (run: just install)"
  exit 1
fi

if [[ "${OAT_RUNTIME:-docker}" == "docker" ]]; then
  check_cmd docker
  check_cmd just

  if ! command -v docker >/dev/null 2>&1; then
    echo "[fail] runtime      Docker is required"
    exit 1
  fi
  if ! docker compose version >/dev/null 2>&1; then
    echo "[fail] compose      Docker Compose v2 is required"
    exit 1
  fi
  echo "[ok]   compose      $(docker compose version --short 2>/dev/null || docker compose version)"

  image="${OAT_RUNTIME_IMAGE:-opencode-agent-toolkit:local}"
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    echo "[fail] image        missing: $image (run: just install)"
    exit 1
  fi
  echo "[ok]   image        $image"

  if docker run --rm --entrypoint bash "$image" -lc '
      set -euo pipefail
      cd /opt/oat
      cp .env.example .env
      set -a; source .env; set +a
      command -v opencode >/dev/null
      command -v opencode2 >/dev/null
      command -v python3 >/dev/null
      command -v node >/dev/null
      command -v npm >/dev/null
      command -v nix >/dev/null
      command -v docker >/dev/null
      python3 ./scripts/generate-config >/dev/null
      python3 ./scripts/apply-reliability >/dev/null
      python3 -m json.tool opencode.jsonc >/dev/null
      python3 -m json.tool opencode.v2.jsonc >/dev/null
      python3 -m unittest discover -s tests >/dev/null
      node --test tests/*.test.mjs >/dev/null
    '; then
    echo "[ok]   container    CLIs, configs and tests valid"
  else
    echo "[fail] container    runtime validation failed"
    ok=0
  fi

  projects_root="${PROJECTS_ROOT:-$HOME/Projects}"
  [[ -d "$projects_root" ]] && echo "[ok]   Projects     $projects_root" || echo "[warn] Projects     not found: $projects_root"
  echo "[info] runtime      docker (host Python/Node/OpenCode not required)"
  echo "[info] V1 server    http://127.0.0.1:${OAT_OC_PORT:-4095}"
  echo "[info] V2 server    http://127.0.0.1:${OAT_OC2_PORT:-4096}"
  echo "[warn] Docker sock  runtime has host-equivalent Docker access by design"
  exit $((1-ok))
fi

# Legacy host-runtime checks.
check_cmd python3
check_cmd just
check_cmd opencode
check_cmd opencode2

[[ -d .venv ]] && echo "[ok]   .venv        present" || echo "[warn] .venv        missing (API dependencies are not installed)"

python3 ./scripts/generate-config >/dev/null
python3 ./scripts/apply-reliability >/dev/null
if python3 -m json.tool opencode.jsonc >/dev/null 2>&1 && python3 -m json.tool opencode.v2.jsonc >/dev/null 2>&1; then
  echo "[ok]   configs      valid JSON + reliability policy applied"
else
  echo "[fail] configs      invalid JSON"
  ok=0
fi

if python3 -m unittest discover -s tests >/dev/null 2>&1; then
  echo "[ok]   tests        passing"
else
  echo "[fail] tests        failing"
  ok=0
fi

projects_root="${PROJECTS_ROOT:-$HOME/Projects}"
[[ -d "$projects_root" ]] && echo "[ok]   Projects     $projects_root" || echo "[warn] Projects     not found: $projects_root"
echo "[info] runtime      host / OPENCODE_MAJOR=${OPENCODE_MAJOR:-1}"
echo "[info] profile      ${MODEL_PROFILE:-custom}"
echo "[info] parallel     ${MAX_PARALLEL_SUBAGENTS:-3}"
echo "[info] queue        ${SUBAGENT_QUEUE_TIMEOUT_SECONDS:-600}s"
echo "[info] stalled      ${SUBAGENT_STALLED_TIMEOUT_SECONDS:-180}s"

if python3 ./scripts/resolve-models --show >/dev/null 2>&1; then
  echo "[ok]   model tiers  LOW/MEDIUM/HIGH resolved"
  echo "[info] LOW          ${MODEL_LOW:-}"
  echo "[info] MEDIUM       ${MODEL_MEDIUM:-}"
  echo "[info] HIGH         ${MODEL_HIGH:-}"
else
  echo "[fail] model tiers  invalid or incomplete"
  ok=0
fi

python3 - <<'PY'
import json
from pathlib import Path
for filename, key in (("opencode.jsonc", "agent"), ("opencode.v2.jsonc", "agents")):
    data = json.loads(Path(filename).read_text())
    commands = data.get("command", data.get("commands", {}))
    print(f"[info] {filename:<17} {len(data[key])} agents, {len(commands)} commands")
PY

exit $((1-ok))
