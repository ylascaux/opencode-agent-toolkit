#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
set -a
source "$ROOT/.env"
[[ -f "$ROOT/.env.local" ]] && source "$ROOT/.env.local"
set +a
cd "$ROOT/tools/project_inventory"
exec uvicorn api:app --host "${PROJECT_INVENTORY_HOST:-127.0.0.1}" --port "${PROJECT_INVENTORY_PORT:-8765}"
