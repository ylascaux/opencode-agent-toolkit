#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
INVOKED_AS="$(basename "$0")"
REQUESTED_MAJOR="${OPENCODE_MAJOR:-}"
REQUESTED_BIN="${OPENCODE_BIN:-}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" == /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# These local tools must work before installation and without provider credentials.
case "${1:-}" in
  sync) shift; exec python3 -B "$ROOT/scripts/sync-runtime" "$@" ;;
  codex) shift; exec python3 -B "$ROOT/scripts/codex" "$@" ;;
esac
if [[ "${1:-}" == memory && "${2:-}" == mcp ]]; then
  shift 2
  exec python3 -B "$ROOT/scripts/memory-mcp" "$@"
fi

set -a
if [[ -f "$ROOT/.env" ]]; then
  source "$ROOT/.env"
elif [[ -f "$ROOT/.env.example" ]]; then
  source "$ROOT/.env.example"
fi
[[ ! -f "$ROOT/.env.local" ]] || source "$ROOT/.env.local"
set +a

# Native-only, including upgrades from an existing Docker/sandbox installation.
# Old runtime settings cannot silently bring containers or watchdogs back.
export OAT_RUNTIME=host OAT_SANDBOX_ENABLED=0 PLAN_APPROVAL_MODE=off
if [[ "$INVOKED_AS" == oc2 ]]; then
  OPENCODE_MAJOR=2
elif [[ -n "$REQUESTED_MAJOR" ]]; then
  OPENCODE_MAJOR="$REQUESTED_MAJOR"
fi
[[ -z "$REQUESTED_BIN" ]] || OPENCODE_BIN="$REQUESTED_BIN"
export OPENCODE_MAJOR="${OPENCODE_MAJOR:-1}"

if [[ "${1:-}" == memory ]]; then
  shift
  [[ $# -gt 0 ]] || set -- --help
  exec python3 -B "$ROOT/scripts/memory" "$@"
fi

configure() {
  python3 -B "$ROOT/scripts/generate-config" --native >/dev/null
  python3 -B "$ROOT/scripts/apply-memory" >/dev/null
}
if [[ "${1:-}" == config ]]; then
  configure
  echo "Native V1/V2 configurations generated."
  exit 0
fi

case "$OPENCODE_MAJOR" in
  1) bin="${OPENCODE_BIN:-opencode}"; config="$ROOT/opencode.jsonc" ;;
  2) bin="${OPENCODE_BIN:-opencode2}"; config="$ROOT/opencode.v2.jsonc" ;;
  auto)
    if command -v opencode2 >/dev/null 2>&1; then
      export OPENCODE_MAJOR=2; bin="${OPENCODE_BIN:-opencode2}"; config="$ROOT/opencode.v2.jsonc"
    else
      export OPENCODE_MAJOR=1; bin="${OPENCODE_BIN:-opencode}"; config="$ROOT/opencode.jsonc"
    fi ;;
  *) echo "OPENCODE_MAJOR must be 1, 2, or auto" >&2; exit 2 ;;
esac
resolved="$(command -v "$bin" || true)"
if [[ -z "$resolved" ]]; then
  echo "Native OpenCode binary not found: $bin. Install it or set OPENCODE_BIN to its path." >&2
  exit 127
fi
if [[ "$resolved" -ef "$SOURCE" ]]; then
  echo "OPENCODE_BIN points to the toolkit launcher, not the native OpenCode binary." >&2
  exit 2
fi

# Login/help must remain usable even when a model or the optional memory is broken.
case "${1:-}" in
  auth|--help|-h|--version|-v|version|upgrade) exec "$bin" "$@" ;;
esac

configure
if [[ -f "$ROOT/scripts/opencode-skill-source" ]]; then
  OPENCODE_CONFIG_CONTENT="$(python3 -B "$ROOT/scripts/opencode-skill-source" "$ROOT/.opencode/skills")"
  export OPENCODE_CONFIG_CONTENT
fi
model_env="$(python3 -B "$ROOT/scripts/resolve-models")"
eval "$model_env"
export OPENCODE_CONFIG="$config"

# V2 uses a fresh local runtime for interactive/run sessions. An explicitly
# requested remote server or foreground serve command remains untouched.
if [[ "$OPENCODE_MAJOR" == 2 ]]; then
  standalone=1
  [[ "${1:-}" != serve ]] || standalone=0
  for arg in "$@"; do
    case "$arg" in
      --server|--server=*|--standalone) standalone=0 ;;
    esac
  done
  [[ "$standalone" == 0 ]] || set -- --standalone "$@"
fi
exec "$bin" "$@"
