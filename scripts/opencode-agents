#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
INVOKED_AS="$(basename "$0")"
REQUESTED_MAJOR="${OPENCODE_MAJOR:-}"
REQUESTED_BIN="${OPENCODE_BIN:-}"

while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  if [[ "$SOURCE" != /* ]]; then
    SOURCE="$SOURCE_DIR/$SOURCE"
  fi
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

if [[ ! -f "$ROOT/.env" ]]; then
  echo "Missing $ROOT/.env. Run: just install" >&2
  exit 1
fi

set -a
source "$ROOT/.env"
[[ -f "$ROOT/.env.local" ]] && source "$ROOT/.env.local"
set +a

# The generated V2 config always points at scripts/sandbox-shell-v2. When sandboxing
# is disabled, that wrapper delegates to the user's real host shell instead of
# changing shell semantics merely because the toolkit is installed.
export OAT_SANDBOX_HOST_SHELL="${OAT_SANDBOX_HOST_SHELL:-${SHELL:-/bin/bash}}"

# Explicit launcher/runtime selection wins over .env defaults.
# `oc2` is a dedicated OpenCode 2 beta entrypoint and always selects V2.
if [[ "$INVOKED_AS" == "oc2" ]]; then
  OPENCODE_MAJOR=2
elif [[ -n "$REQUESTED_MAJOR" ]]; then
  OPENCODE_MAJOR="$REQUESTED_MAJOR"
fi

if [[ -n "$REQUESTED_BIN" ]]; then
  OPENCODE_BIN="$REQUESTED_BIN"
fi

export OPENCODE_MAJOR
[[ -z "${OPENCODE_BIN:-}" ]] || export OPENCODE_BIN

python3 "$ROOT/scripts/generate-config" >/dev/null
if [[ -f "$ROOT/scripts/apply-memory" ]]; then
  python3 "$ROOT/scripts/apply-memory" >/dev/null
elif [[ "${OAT_MEMORY_ENABLED:-0}" == "1" ]]; then
  echo "Memory is enabled but $ROOT/scripts/apply-memory is missing" >&2
  exit 1
fi
python3 "$ROOT/scripts/apply-reliability" >/dev/null

# Resolve unset per-agent MODEL_* variables from the active LOW/MEDIUM/HIGH tiers.
eval "$(python3 "$ROOT/scripts/resolve-models")"

major="${OPENCODE_MAJOR:-1}"
case "$major" in
  1)
    bin="${OPENCODE_BIN:-opencode}"
    config="$ROOT/opencode.jsonc"
    ;;
  2)
    bin="${OPENCODE_BIN:-opencode2}"
    config="$ROOT/opencode.v2.jsonc"
    ;;
  auto)
    if command -v opencode2 >/dev/null 2>&1; then
      bin="${OPENCODE_BIN:-opencode2}"
      config="$ROOT/opencode.v2.jsonc"
      major=2
    else
      bin="${OPENCODE_BIN:-opencode}"
      config="$ROOT/opencode.jsonc"
      major=1
    fi
    ;;
  *)
    echo "OPENCODE_MAJOR must be 1, 2, or auto (got: $major)" >&2
    exit 2
    ;;
esac

if ! command -v "$bin" >/dev/null 2>&1; then
  echo "OpenCode binary not found: $bin" >&2
  exit 127
fi

if [[ "${OPENCODE_PREFLIGHT:-1}" == "1" ]]; then
  bash "$ROOT/scripts/preflight"
fi

export OPENCODE_CONFIG="$config"

if [[ "${OAT_SANDBOX_ENABLED:-0}" != "1" ]]; then
  exec "$bin" "$@"
fi

project_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || pwd -P)"
export OAT_SANDBOX_PROJECT_ROOT="$(cd "$project_root" && pwd -P)"
container="$(bash "$ROOT/scripts/sandbox-start" "$OAT_SANDBOX_PROJECT_ROOT" | tail -n 1)"
[[ -n "$container" ]] || {
  echo "Sandbox startup did not return a container name" >&2
  exit 3
}
export OAT_SANDBOX_CONTAINER="$container"

cleanup_sandbox() {
  bash "$ROOT/scripts/sandbox-stop" "$OAT_SANDBOX_CONTAINER" || true
}
trap cleanup_sandbox EXIT INT TERM

echo "OpenCode sandbox: $OAT_SANDBOX_CONTAINER ($OAT_SANDBOX_PROJECT_ROOT -> /workspace)" >&2
set +e
"$bin" "$@"
status=$?
set -e
cleanup_sandbox
trap - EXIT INT TERM
exit "$status"
