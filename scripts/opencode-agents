#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
REQUESTED_BIN="${OPENCODE_BIN:-}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" == /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Local toolkit operations do not require OpenCode or provider authentication.
case "${1:-}" in
  sync|codex)
    command_name="$1"
    shift
    [[ "$command_name" != sync ]] || command_name=sync-runtime
    exec python3 -B "$ROOT/scripts/$command_name" "$@"
    ;;
  doctor)
    shift
    exec bash "$ROOT/scripts/doctor" "$@"
    ;;
esac
if [[ "${1:-}" == memory && "${2:-}" == mcp ]]; then
  shift 2
  exec python3 -B "$ROOT/scripts/memory-mcp" "$@"
fi

set -a
if [[ -f "$ROOT/.env" ]]; then
  source "$ROOT/.env"
elif [[ -f "$ROOT/.env.example" ]]; then
  source "$ROOT/.env.example"
fi
[[ ! -f "$ROOT/.env.local" ]] || source "$ROOT/.env.local"
set +a

export OAT_RUNTIME=host OAT_SANDBOX_ENABLED=0 PLAN_APPROVAL_MODE=off

if [[ "${1:-}" == memory ]]; then
  shift
  [[ $# -gt 0 ]] || set -- --help
  exec python3 -B "$ROOT/scripts/memory" "$@"
fi

bin="${REQUESTED_BIN:-opencode}"
config="$ROOT/opencode.jsonc"
if ! command -v "$bin" >/dev/null 2>&1; then
  echo "OpenCode 2 binary not found: $bin. Run 'just install'." >&2
  exit 127
fi

# Authentication and basic CLI diagnostics must remain usable even if toolkit
# configuration or optional memory setup is temporarily broken.
case "${1:-}" in
  auth|--help|-h|--version|-v|version)
    exec "$bin" "$@"
    ;;
esac

python3 -B "$ROOT/scripts/configure-local" >/dev/null
eval "$(python3 -B "$ROOT/scripts/resolve-models")"

# create-ai-memory is installed in toolkit-owned user data. The adapter keeps
# the upstream package unmodified while mapping it onto the structured
# opencode-memory Git/Obsidian vault.
unset OAT_AI_MEMORY_ADAPTER OAT_AI_MEMORY_CONTEXT_FILE OAT_AI_MEMORY_PROJECT || true
case "${OAT_AI_MEMORY_ENABLED:-1}" in
  0|false|FALSE|no|NO|off|OFF)
    ;;
  *)
    memory_home="${OAT_AI_MEMORY_HOME:-$HOME/.local/share/opencode-agent-toolkit/vendor/ai-memory/node_modules/create-ai-memory}"
    memory_root="${OAT_AI_MEMORY_ROOT:-$HOME/opencode-memory}"
    memory_adapter="$ROOT/scripts/ai-memory-adapter"
    if [[ -f "$memory_home/shell/ai-mem.zsh" && -d "$memory_root" ]] && command -v zsh >/dev/null 2>&1; then
      memory_context="${TMPDIR:-/tmp}/oat-ai-memory-${UID:-0}-$.md"
      if memory_project="$(python3 -B "$memory_adapter" prepare --home "$memory_home" --root "$memory_root" --cwd "$PWD" --context-file "$memory_context")"; then
        export OAT_AI_MEMORY_HOME="$memory_home"
        export OAT_AI_MEMORY_ROOT="$memory_root"
        export OAT_AI_MEMORY_PROJECT="$memory_project"
        export OAT_AI_MEMORY_CONTEXT_FILE="$memory_context"
        export OAT_AI_MEMORY_ADAPTER="$memory_adapter"
      else
        rm -f "$memory_context"
        printf '%s\n' 'AI memory preparation failed; continuing without persistent memory.' >&2
      fi
    else
      printf '%s\n' 'create-ai-memory or its vault is missing; run just install to enable persistent memory.' >&2
    fi
    ;;
esac

export OPENCODE_CONFIG="$config"
export OPENCODE_CONFIG_CONTENT="$(
  python3 -B "$ROOT/scripts/opencode-skill-source" "$ROOT/.opencode/skills"
)"

# Use a private server for normal TUI/run invocations so stale background
# services cannot retain an old config. Explicit server-oriented commands pass through.
standalone=1
case "${1:-}" in
  serve|service|server|attach|models|mcp|plugin|session|debug|upgrade|update|uninstall|api|acp|reload|stats)
    standalone=0
    ;;
esac
for arg in "$@"; do
  case "$arg" in
    --server|--server=*|--standalone)
      standalone=0
      ;;
  esac
done
[[ "$standalone" == 0 ]] || set -- --standalone "$@"

exec "$bin" "$@"
