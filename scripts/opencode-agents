#!/usr/bin/env bash
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
REQUESTED_BIN="${OPENCODE_BIN:-}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" == /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

case "${1:-}" in
  sync|codex)
    command_name="$1"; shift
    [[ "$command_name" != sync ]] || command_name=sync-runtime
    exec python3 -B "$ROOT/scripts/$command_name" "$@"
    ;;
  doctor)
    shift; exec bash "$ROOT/scripts/doctor" "$@"
    ;;
esac

set -a
if [[ -f "$ROOT/.env" ]]; then
  source "$ROOT/.env"
elif [[ -f "$ROOT/.env.example" ]]; then
  source "$ROOT/.env.example"
fi
[[ ! -f "$ROOT/.env.local" ]] || source "$ROOT/.env.local"
set +a

export OAT_RUNTIME=host OAT_SANDBOX_ENABLED=0 PLAN_APPROVAL_MODE=off
bin="${REQUESTED_BIN:-${OPENCODE_BIN:-opencode}}"
config="$ROOT/opencode.jsonc"

if ! command -v "$bin" >/dev/null 2>&1; then
  echo "OpenCode 2 binary not found: $bin. Run 'just install' or set OPENCODE_BIN." >&2
  exit 127
fi

case "${1:-}" in
  auth|--help|-h|--version|-v|version|upgrade|update|uninstall)
    exec "$bin" "$@"
    ;;
esac

python3 -B "$ROOT/scripts/configure-local" >/dev/null
resolved_models="$(python3 -B "$ROOT/scripts/resolve-models")"
eval "$resolved_models"

if [[ "${OAT_MEMORY_ENABLED:-1}" != "0" ]]; then
  if ! python3 -B "$ROOT/scripts/configure-memory" >/dev/null; then
    printf '%s\n' 'OpenCode memory configuration failed; continuing with plugin defaults.' >&2
  fi
fi

export OPENCODE_CONFIG="$config"
inline_config="$(python3 -B "$ROOT/scripts/opencode-skill-source" "$ROOT/.opencode/skills")"
export OPENCODE_CONFIG_CONTENT="$inline_config"

exec "$bin" "$@"
