#!/usr/bin/env python3
"""Exercise the installed stable OpenCode launcher against a real local server."""
from __future__ import annotations

import base64
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import tempfile
import time
import urllib.error
import urllib.request

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    native = shutil.which("opencode")
    if native is None:
        raise SystemExit("install the stable OpenCode 2 CLI before running this smoke test")

    with tempfile.TemporaryDirectory(prefix="oat-native-smoke-") as temporary:
        work = Path(temporary).resolve()
        toolkit, home, project = (work / name for name in ("toolkit", "home", "project with spaces"))
        toolkit.mkdir()
        home.mkdir()
        project.mkdir()
        for directory in ("agents", "skills", "runtime", "scripts"):
            shutil.copytree(ROOT / directory, toolkit / directory, ignore=shutil.ignore_patterns("__pycache__"))
        shutil.copy2(ROOT / ".env.example", toolkit / ".env.example")

        env = {
            "PATH": os.environ.get("PATH", ""),
            "HOME": str(home),
            "XDG_CONFIG_HOME": str(home / ".config"),
            "XDG_DATA_HOME": str(home / ".local/share"),
            "XDG_STATE_HOME": str(home / ".local/state"),
            "XDG_CACHE_HOME": str(home / ".cache"),
            "CI": "1",
            "OPENCODE_DISABLE_MODELS_FETCH": "1",
            "OAT_INSTALL_OPENCODE": "0",
            "OAT_INSTALL_PLUGINS": "0",
            "OAT_MEMORY_ENABLED": "0",
            "OPENCODE_BIN": native,
            "OPENCODE_SERVER_USERNAME": "opencode",
            "OPENCODE_SERVER_PASSWORD": "native-smoke-only",
        }
        subprocess.run(["bash", str(toolkit / "scripts/bootstrap")], cwd=project, env=env, check=True)

        skill = project / ".agents/skills/project-skill/SKILL.md"
        skill.parent.mkdir(parents=True)
        skill.write_text("---\nname: project-skill\ndescription: Local project smoke skill\n---\n\nFixture.\n")
        subprocess.run(["git", "init", "-q"], cwd=project, env=env, check=True)
        launcher = home / ".local/bin" / "oc"

        with socket.socket() as port_probe:
            port_probe.bind(("127.0.0.1", 0))
            port = port_probe.getsockname()[1]

        with (work / "server.log").open("w+") as log:
            server = subprocess.Popen(
                [str(launcher), "serve", "--hostname", "127.0.0.1", "--port", str(port)],
                cwd=project,
                env=env,
                stdout=log,
                stderr=subprocess.STDOUT,
            )
            try:
                def fetch(route: str):
                    request = urllib.request.Request(
                        f"http://127.0.0.1:{port}{route}",
                        headers={
                            "Authorization": "Basic " + base64.b64encode(b"opencode:native-smoke-only").decode(),
                            "x-opencode-directory": str(project),
                        },
                    )
                    with urllib.request.urlopen(request, timeout=3) as response:
                        return json.load(response)

                expected = {"test-review", "security-review", "terraform-review", "project-skill"}
                payload = None
                agent_payload = None
                ids = set()
                deadline = time.monotonic() + 90
                while time.monotonic() < deadline and server.poll() is None:
                    try:
                        payload = fetch("/api/skill")
                        assert isinstance(payload, dict) and isinstance(payload.get("data"), list), payload
                        ids = {item["id"] for item in payload["data"]}
                        agent_payload = fetch("/api/agent")
                        agent_ids = {item["id"] for item in agent_payload.get("data", [])}
                        if expected <= ids and {"meta-router", "orchestrator", "builder"} <= agent_ids:
                            break
                    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
                        pass
                    time.sleep(0.5)

                if payload is None:
                    raise RuntimeError("Stable OpenCode server did not load the generated configuration")
                assert expected <= ids, f"Missing skills: {sorted(expected - ids)}; response={payload!r}"
                assert payload.get("location", {}).get("directory") == str(project), payload
                agent_ids = {item["id"] for item in agent_payload.get("data", [])}
                assert {"meta-router", "orchestrator", "builder"} <= agent_ids, agent_payload
                print(f"PASS stable OpenCode 2: skills={len(ids)} agents={len(agent_ids)}")
            except Exception:
                log.flush()
                log.seek(0)
                print(log.read())
                raise
            finally:
                if server.poll() is None:
                    server.terminate()
                    try:
                        server.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        server.kill()
                        server.wait(timeout=5)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
