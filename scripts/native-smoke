#!/usr/bin/env python3
"""Exercise the installed native launcher against a real local OpenCode server.

Uses an isolated home, project and toolkit copy; never calls a model or reads
provider accounts. CLI binaries are prerequisites, not installed by this script.
"""
from __future__ import annotations

import argparse
import base64
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import tempfile
import time
import urllib.error
import urllib.request

ROOT = Path(__file__).resolve().parents[1]


def install_memory_fixture(toolkit: Path, home: Path) -> None:
    plugin = home / ".local/share/opencode-agent-toolkit/plugins/opencode-memory-plugin"
    dist = plugin / "dist"
    dist.mkdir(parents=True)
    (plugin / "package.json").write_text('{"type":"module"}\n')
    (dist / "v2.js").write_text(
        'export default { id: "opencode.memory.smoke", async setup() {} }\n'
    )
    (dist / "v1.js").write_text(
        'export default async function memorySmoke() { return {} }\n'
    )
    (dist / "cli.js").write_text(
        '#!/usr/bin/env node\n'
        'if (process.argv[2] === "render") process.exit(0)\n'
        'process.exit(0)\n'
    )
    vault = home / ".local/share/opencode-agent-toolkit/memory"
    vault.mkdir(parents=True)
    (toolkit / ".env.local").write_text(
        "OAT_MEMORY_ENABLED=1\n"
        "OAT_MEMORY_CAPTURE_ENABLED=1\n"
        f"OAT_MEMORY_PLUGIN_DIR={plugin}\n"
        f"OAT_MEMORY_DIR={vault}\n"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("major", choices=("1", "2"))
    args = parser.parse_args()
    native = shutil.which("opencode2" if args.major == "2" else "opencode")
    if native is None:
        parser.error("install the native CLI before running this smoke test")
    with tempfile.TemporaryDirectory(prefix="oat-native-smoke-") as temporary:
        work = Path(temporary).resolve()
        toolkit, home, project = (work / name for name in ("toolkit", "home", "project with spaces"))
        toolkit.mkdir()
        home.mkdir()
        project.mkdir()
        for directory in ("agents", "skills", "runtime", "scripts"):
            shutil.copytree(ROOT / directory, toolkit / directory, ignore=shutil.ignore_patterns("__pycache__"))
        shutil.copy2(ROOT / ".env.example", toolkit / ".env.example")
        env = {
            "PATH": os.environ.get("PATH", ""), "HOME": str(home),
            "XDG_CONFIG_HOME": str(home / ".config"), "XDG_DATA_HOME": str(home / ".local/share"),
            "XDG_STATE_HOME": str(home / ".local/state"), "XDG_CACHE_HOME": str(home / ".cache"),
            "CI": "1", "OPENCODE_DISABLE_MODELS_FETCH": "1",
            "OPENCODE_BIN": native,
            "OPENCODE_SERVER_USERNAME": "opencode", "OPENCODE_SERVER_PASSWORD": "native-smoke-only",
        }
        subprocess.run(["bash", str(toolkit / "scripts/bootstrap")], cwd=project, env=env, check=True)
        # A project-owned skill must survive alongside the toolkit skill sources.
        skill = project / ".agents/skills/project-skill/SKILL.md"
        skill.parent.mkdir(parents=True)
        skill.write_text("---\nname: project-skill\ndescription: Local project smoke skill\n---\n\nFixture.\n")
        subprocess.run(["git", "init", "-q"], cwd=project, env=env, check=True)
        launcher = home / ".local/bin" / ("oc2" if args.major == "2" else "oc")

        if args.major == "2":
            install_memory_fixture(toolkit, home)
            plugins = subprocess.run(
                [str(launcher), "plugin", "list"],
                cwd=project,
                env=env,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=60,
                check=False,
            )
            assert plugins.returncode == 0, plugins.stdout
            assert "opencode.memory.smoke" in plugins.stdout, plugins.stdout
            wrapper = toolkit / ".generated/plugins/opencode-memory-plugin-v2"
            assert (wrapper / "index.js").is_file(), wrapper
            print("V2 plugin list contains opencode.memory.smoke")

        with socket.socket() as port_probe:
            port_probe.bind(("127.0.0.1", 0))
            port = port_probe.getsockname()[1]
        with (work / "server.log").open("w+") as log:
            server = subprocess.Popen([str(launcher), "serve", "--hostname", "127.0.0.1", "--port", str(port)],
                                      cwd=project, env=env, stdout=log, stderr=subprocess.STDOUT)
            try:
                def fetch(route):
                    request = urllib.request.Request(f"http://127.0.0.1:{port}{route}", headers={
                        "Authorization": "Basic " + base64.b64encode(b"opencode:native-smoke-only").decode(),
                        "x-opencode-directory": str(project),
                    })
                    with urllib.request.urlopen(request, timeout=3) as response:
                        return json.load(response)

                expected = {"test-review", "security-review", "terraform-review", "project-skill"}
                payload = None
                agent_payload = None
                ids = set()
                deadline = time.monotonic() + 90
                # HTTP readiness precedes asynchronous resource discovery in V2.
                # Wait for the actual catalogue, not merely the first HTTP 200.
                while time.monotonic() < deadline and server.poll() is None:
                    try:
                        payload = fetch("/api/skill" if args.major == "2" else "/config")
                        if args.major == "1":
                            break
                        assert isinstance(payload, dict) and isinstance(payload.get("data"), list), payload
                        ids = {item["id"] for item in payload["data"]}
                        agent_payload = fetch("/api/agent")
                        agent_ids = {item["id"] for item in agent_payload.get("data", [])}
                        if expected <= ids and {"meta-router", "orchestrator", "builder"} <= agent_ids:
                            break
                    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
                        pass
                    time.sleep(0.5)
                if payload is None:
                    raise RuntimeError("Native server did not load the generated configuration")
                if args.major == "2":
                    assert expected <= ids, f"Missing skills: {sorted(expected - ids)}; response={payload!r}"
                    assert payload.get("location", {}).get("directory") == str(project), payload
                    agent_ids = {item["id"] for item in agent_payload.get("data", [])}
                    assert {"meta-router", "orchestrator", "builder"} <= agent_ids, agent_payload
                    print(f"V2 discovered skills: {sorted(ids)}; agents: {len(agent_ids)}")
                else:
                    assert payload["default_agent"] == "meta-router", payload
                    assert "orchestrator" in payload["agent"] and "builder" in payload["agent"]
                    assert payload.get("plugin", []) == [], payload.get("plugin")
                print(f"PASS real native V{args.major} server: isolated project, generated config and runtime API")
            except Exception:
                log.flush()
                log.seek(0)
                print(log.read())
                raise
            finally:
                if server.poll() is None:
                    server.terminate()
                    try:
                        server.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        server.kill()
                        server.wait(timeout=5)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
