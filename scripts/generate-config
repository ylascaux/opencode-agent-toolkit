#!/usr/bin/env python3
from __future__ import annotations

from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from runtime.common.normalization import load_normalized_agents, load_normalized_skills  # noqa: E402
from runtime.opencode.adapter import OpenCodeAdapter  # noqa: E402


def main() -> None:
    if sys.argv[1:] not in ([], ['--native']):
        raise SystemExit('Usage: generate-config [--native]')
    adapter = OpenCodeAdapter()
    if sys.argv[1:] == ['--native']:
        from runtime.opencode.native import NativeOpenCodeAdapter
        adapter = NativeOpenCodeAdapter()
    specs = load_normalized_agents()
    skills = load_normalized_skills()
    outputs = adapter.generate(specs, skills)
    for path in outputs:
        print(f"generated {path.name}: {len(specs)} agents")
    print("agent source: agents/<name>/{agent.json,prompt.md,permissions.json}; skill source: skills/<name>/{skill.json,SKILL.md}")


if __name__ == '__main__':
    main()
