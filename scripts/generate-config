#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = json.loads((ROOT / "agents" / "manifest.json").read_text())
DESCRIPTIONS = {name: spec["description"] for name, spec in MANIFEST.items()}

MODEL_ENV_OVERRIDES = {
    "architecture-designer": "MODEL_ARCHITECTURE",
    "aws-platform": "MODEL_AWS",
    "terraform-terragrunt": "MODEL_TERRAFORM",
    "python-specialist": "MODEL_PYTHON",
    "go-specialist": "MODEL_GO",
    "docs-writer": "MODEL_DOCS",
}

LEAD_CHILDREN = {
    "meta-router": [
        "orchestrator", "review-lead", "platform-architect", "security-lead",
        "arbiter", "deep-reasoner", "evidence-auditor",
    ],
    "orchestrator": [
        "brainstorm", "planner", "builder", "reviewer", "tester", "mock-generator",
        "debugger", "project-scanner", "architecture-designer", "aws-platform",
        "terraform-terragrunt", "kubernetes", "python-specialist", "go-specialist",
        "cicd", "sre", "observability", "finops", "threat-model", "appsec",
        "iac-security", "supply-chain", "pentest", "secrets", "docs-writer",
        "arbiter", "deep-reasoner", "evidence-auditor", "api-contract",
        "performance", "database", "networking",
    ],
    "review-lead": [
        "reviewer", "api-contract", "performance", "database", "networking",
        "appsec", "iac-security", "supply-chain", "evidence-auditor",
        "arbiter", "deep-reasoner",
    ],
    "platform-architect": [
        "project-scanner", "architecture-designer", "aws-platform",
        "terraform-terragrunt", "kubernetes", "cicd", "sre", "observability",
        "finops", "database", "networking", "threat-model", "iac-security",
        "arbiter", "deep-reasoner", "evidence-auditor",
    ],
    "security-lead": [
        "threat-model", "appsec", "iac-security", "supply-chain", "pentest",
        "secrets", "arbiter", "deep-reasoner", "evidence-auditor",
    ],
}

WRITERS = {
    "builder", "tester", "mock-generator", "debugger", "python-specialist",
    "go-specialist", "cicd", "docs-writer",
}
SECURITY_TOOL_AGENTS = {"appsec", "iac-security", "supply-chain", "secrets"}
SAFE_EVIDENCE_SHELL = {
    "*": "ask",
    "git status*": "allow",
    "git diff*": "allow",
    "git show*": "allow",
    "git log*": "allow",
    "git rev-parse*": "allow",
}
WEB_DENY = {
    "meta-router", "orchestrator", "review-lead", "reviewer", "tester",
    "mock-generator", "planner", "project-scanner", "arbiter",
    "evidence-auditor", "secrets", "pentest",
}
SKILL_DENY = {
    "meta-router", "review-lead", "reviewer", "tester", "mock-generator",
    "project-scanner", "arbiter", "evidence-auditor", "secrets", "pentest",
}
STEPS = {
    "meta-router": 20, "orchestrator": 32, "review-lead": 20, "security-lead": 20,
    "platform-architect": 24, "deep-reasoner": 24, "arbiter": 14,
    "evidence-auditor": 16, "terraform-terragrunt": 24, "debugger": 24,
    "builder": 26, "python-specialist": 22, "go-specialist": 22,
    "project-scanner": 20, "architecture-designer": 20, "aws-platform": 20,
    "kubernetes": 20, "tester": 20, "pentest": 20,
}

COMMANDS = {
    "auto": (
        "Automatically classify and route a task",
        "Route and execute $ARGUMENTS using the minimum sufficient path. Use the routing contract, keep delegation depth <= 2, escalate only on risk/uncertainty/disagreement, and finish with evidence and residual risk.",
    ),
    "ship": (
        "Implement with tests, independent review and adaptive security gates",
        "Ship $ARGUMENTS. Classify risk first, delegate delivery to orchestrator, require relevant tests and independent review, add only security gates matching the changed attack surface, and audit non-trivial completion evidence.",
    ),
    "review": (
        "Run independent adaptive review",
        "Review $ARGUMENTS via review-lead. Select only review dimensions touched by the change, deduplicate findings, arbitrate material disagreement, and audit weak completion claims.",
    ),
    "architecture": (
        "Run the adaptive platform architecture council",
        "Design or review $ARGUMENTS via platform-architect. Discover repository evidence when needed, select only relevant platform domains, include threat/IaC security for changed trust boundaries, and return trade-offs, migration/rollback and residual risks.",
    ),
    "security": (
        "Run adaptive defense-in-depth security review",
        "Security-review $ARGUMENTS via security-lead. Select only relevant threat-model/AppSec/IaC/supply-chain/secrets gates; pentest only explicitly authorized runtime scope. Deduplicate, rank and verify findings.",
    ),
    "debug": (
        "Evidence-first debugging workflow",
        "Debug $ARGUMENTS via orchestrator. Start with reproduction/evidence, use the affected specialist, add regression coverage, independently review the fix and add security gates if a trust boundary changes.",
    ),
    "incident": (
        "Investigate an incident with SRE and observability",
        "Investigate $ARGUMENTS via orchestrator using evidence-first debugging plus SRE/observability and affected domain specialists. Separate facts from hypotheses, identify blast radius, mitigation/rollback and follow-up evidence.",
    ),
    "cost": (
        "Analyze platform cost and cost-performance trade-offs",
        "Analyze $ARGUMENTS via platform-architect using FinOps plus only relevant AWS/Kubernetes/database/networking/performance perspectives. State source data, assumptions, trade-offs and confidence.",
    ),
}

SECRET_READ_PATTERNS = [
    "*.env", "*.env.*", "**/.env", "**/.env.*", "*.pem", "*.key",
    "**/.ssh/**", "**/.aws/credentials", "*id_rsa*", "*id_ed25519*",
]

COMMON_PROMPT = """## Evidence discipline
- Separate FACTS, ASSUMPTIONS, and RECOMMENDATIONS.
- Prefer direct repository/tool evidence over another agent's summary.
- Never claim a test, plan, command, runtime check, or source lookup succeeded unless evidence is available.
- Use HIGH confidence only for directly verified/reproduced claims; MEDIUM for strong static/indirect evidence; LOW for unresolved hypotheses.

## Stop conditions
- Stop and mark BLOCKED when required scope, authorization, dependency, or evidence is missing and proceeding would be unsafe or misleading.
- Mark ESCALATION_REQUIRED for material disagreement, high-risk irreversible decisions, or unresolved low-confidence conclusions.
- Do not silently broaden scope.

## Handoff
Finish delegated work with these sections:
- STATUS: COMPLETE | BLOCKED | ESCALATION_REQUIRED
- SUMMARY
- FACTS
- ASSUMPTIONS
- EVIDENCE: exact files/lines, commands/results, logs/metrics, plans, safe requests, or sources
- FINDINGS: severity + confidence + evidence + remediation when applicable
- RESIDUAL RISKS
- RECOMMENDED NEXT AGENTS
- CONFIDENCE: HIGH | MEDIUM | LOW with a short reason

The machine-readable equivalent is documented in `contracts/agent-handoff.schema.json`.
"""


def generate_prompts() -> None:
    prompt_dir = ROOT / "prompts"
    prompt_dir.mkdir(exist_ok=True)
    for name, spec in MANIFEST.items():
        special = spec.get("special", "").strip()
        special_block = f"\n{special}\n" if special else ""
        text = (
            f"# Role\n{spec['description']}\n\n"
            f"## Operating method\n{spec['method']}\n\n"
            f"## Non-negotiables\n{spec['non_negotiables']}\n"
            f"{special_block}\n{COMMON_PROMPT}"
        )
        (prompt_dir / f"{name}.md").write_text(text)


def model_env(name: str) -> str:
    return MODEL_ENV_OVERRIDES.get(name, "MODEL_" + name.upper().replace("-", "_"))


def read_permissions(name: str) -> dict:
    rules: dict[str, str] = {"*": "allow"}
    if name == "project-scanner":
        rules["~/Projects/**"] = "allow"
    for pattern in SECRET_READ_PATTERNS:
        rules[pattern] = "deny"
    return rules


def delegation_permissions(name: str) -> dict:
    rules = {"*": "deny"}
    for child in LEAD_CHILDREN.get(name, []):
        rules[child] = "allow"
    return rules


def shell_permissions(name: str):
    if name in {"reviewer", "evidence-auditor"}:
        return dict(SAFE_EVIDENCE_SHELL)
    if name == "terraform-terragrunt":
        return {
            "*": "ask",
            "terraform fmt*": "allow", "tofu fmt*": "allow",
            "terragrunt hclfmt*": "allow",
            "terraform validate*": "allow", "tofu validate*": "allow",
            "terraform plan*": "ask", "tofu plan*": "ask", "terragrunt plan*": "ask",
            "* apply*": "deny", "* destroy*": "deny",
            "terraform apply*": "deny", "tofu apply*": "deny", "terragrunt apply*": "deny",
            "terraform destroy*": "deny", "tofu destroy*": "deny", "terragrunt destroy*": "deny",
        }
    if name == "pentest":
        return {
            "*": "ask",
            "curl http://127.0.0.1*": "allow", "curl http://localhost*": "allow",
            "curl https://127.0.0.1*": "allow", "curl https://localhost*": "allow",
        }
    if name in SECURITY_TOOL_AGENTS:
        return "ask"
    if name in WRITERS:
        return "ask"
    return "deny"


def v1_permissions(name: str) -> dict:
    p = {
        "task": delegation_permissions(name),
        "edit": "allow" if name in WRITERS or name == "terraform-terragrunt" else "deny",
        "bash": shell_permissions(name),
        "webfetch": "deny" if name in WEB_DENY else "ask",
        "websearch": "deny" if name in WEB_DENY else "ask",
        "skill": "deny" if name in SKILL_DENY else "ask",
        "read": read_permissions(name),
    }
    if name == "project-scanner":
        p["external_directory"] = {"*": "deny", "~/Projects/**": "allow"}
    return p


def v2_permissions(name: str) -> list[dict]:
    p = v1_permissions(name)
    action_map = {"bash": "shell", "task": "subagent"}
    rules: list[dict] = []
    for key, value in p.items():
        action = action_map.get(key, key)
        if isinstance(value, str):
            rules.append({"action": action, "resource": "*", "effect": value})
        else:
            for resource, effect in value.items():
                rules.append({"action": action, "resource": resource, "effect": effect})
    return rules


def agent_entry(name: str, v2: bool) -> dict:
    mode = "primary" if name == "meta-router" else ("all" if name == "orchestrator" else "subagent")
    return {
        "description": DESCRIPTIONS[name],
        "mode": mode,
        "model": f"{{env:{model_env(name)}}}",
        ("system" if v2 else "prompt"): f"{{file:./prompts/{name}.md}}",
        "steps": STEPS.get(name, 16),
        ("permissions" if v2 else "permission"): v2_permissions(name) if v2 else v1_permissions(name),
    }


def build(v2: bool) -> dict:
    agents = {name: agent_entry(name, v2) for name in DESCRIPTIONS}
    commands = {
        name: {"description": desc, "template": template, "agent": "meta-router"}
        for name, (desc, template) in COMMANDS.items()
    }
    if v2:
        return {
            "$schema": "https://opencode.ai/config.json",
            "default_agent": "meta-router",
            "agents": agents,
            "commands": commands,
            "experimental": {"subagent_depth": 2},
        }
    return {
        "$schema": "https://opencode.ai/config.json",
        "default_agent": "meta-router",
        "subagent_depth": 2,
        "agent": agents,
        "command": commands,
    }


def main() -> None:
    generate_prompts()
    outputs = (
        (ROOT / "opencode.jsonc", build(False)),
        (ROOT / "opencode.v2.jsonc", build(True)),
    )
    for path, data in outputs:
        path.write_text(json.dumps(data, indent=2) + "\n")
        print(f"generated {path.name}: {len(data.get('agent', data.get('agents', {})))} agents")


if __name__ == "__main__":
    main()
