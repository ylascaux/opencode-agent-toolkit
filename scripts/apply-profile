#!/usr/bin/env python3
from __future__ import annotations

import argparse
import re
import shutil
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PROFILES = ROOT / "profiles"
ENV_FILE = ROOT / ".env"
BACKUP_FILE = ROOT / ".env.model-overrides.backup"
PROFILE_KEYS = ("MODEL_PROFILE", "MODEL_LOW", "MODEL_MEDIUM", "MODEL_HIGH")
AGENT_OVERRIDE = re.compile(r"^MODEL_(?!PROFILE$|LOW$|MEDIUM$|HIGH$)[A-Z0-9_]+=")


def load_profile(name: str) -> dict[str, str]:
    path = PROFILES / f"{name}.env.example"
    if not path.exists():
        available = ", ".join(sorted(p.name.removesuffix(".env.example") for p in PROFILES.glob("*.env.example")))
        raise SystemExit(f"Unknown profile '{name}'. Available: {available}")
    values: dict[str, str] = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()
    missing = [key for key in PROFILE_KEYS if not values.get(key)]
    if missing:
        raise SystemExit(f"Profile {name} is missing: {', '.join(missing)}")
    if name == "generic" and any(values[key].startswith("provider/") for key in ("MODEL_LOW", "MODEL_MEDIUM", "MODEL_HIGH")):
        raise SystemExit("The generic profile is a template. Edit profiles/generic.env.example before applying it.")
    return values


def apply_profile(name: str) -> None:
    values = load_profile(name)
    if not ENV_FILE.exists():
        shutil.copyfile(ROOT / ".env.example", ENV_FILE)

    lines = ENV_FILE.read_text().splitlines()
    explicit_agent_mappings = [line for line in lines if AGENT_OVERRIDE.match(line)]
    if explicit_agent_mappings:
        BACKUP_FILE.write_text(
            "# Saved automatically before switching model profiles.\n"
            "# Move only the overrides you still want into .env.local.\n"
            + "\n".join(explicit_agent_mappings)
            + "\n"
        )
        print(f"Backed up {len(explicit_agent_mappings)} explicit agent mappings to {BACKUP_FILE.name}")

    out: list[str] = []
    seen: set[str] = set()

    for line in lines:
        match = re.match(r"^([A-Z0-9_]+)=(.*)$", line)
        if match and match.group(1) in PROFILE_KEYS:
            key = match.group(1)
            out.append(f"{key}={values[key]}")
            seen.add(key)
            continue
        # Profiles own .env's generated agent mappings. Persistent per-agent overrides belong in .env.local.
        if AGENT_OVERRIDE.match(line):
            continue
        out.append(line)

    missing = [key for key in PROFILE_KEYS if key not in seen]
    if missing:
        out.extend(["", "# Active model profile"])
        out.extend(f"{key}={values[key]}" for key in missing)

    ENV_FILE.write_text("\n".join(out).rstrip() + "\n")
    print(f"Applied profile: {name}")
    print(f"  LOW    -> {values['MODEL_LOW']}")
    print(f"  MEDIUM -> {values['MODEL_MEDIUM']}")
    print(f"  HIGH   -> {values['MODEL_HIGH']}")
    print("Per-agent overrides can be placed in .env.local and are never modified by profile switching.")


def main() -> int:
    parser = argparse.ArgumentParser(description="Apply a provider/model profile to .env")
    parser.add_argument("profile", help="Profile name, for example copilot or codex")
    args = parser.parse_args()
    apply_profile(args.profile)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
