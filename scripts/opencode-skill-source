#!/usr/bin/env python3
"""Merge toolkit runtime additions into highest-precedence inline config safely."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def append_unique(config: dict, key: str, value: str) -> None:
    current = config.get(key, [])
    if current is None:
        current = []
    if not isinstance(current, list):
        print(f"OPENCODE_CONFIG_CONTENT.{key} must be an array", file=sys.stderr)
        raise SystemExit(2)
    if value not in current:
        current.append(value)
    config[key] = current


def mcp_servers(config: dict) -> dict:
    mcp = config.get("mcp", {})
    if mcp is None:
        mcp = {}
    if not isinstance(mcp, dict):
        print("OPENCODE_CONFIG_CONTENT.mcp must be an object", file=sys.stderr)
        raise SystemExit(2)
    servers = mcp.get("servers", {})
    if servers is None:
        servers = {}
    if not isinstance(servers, dict):
        print("OPENCODE_CONFIG_CONTENT.mcp.servers must be an object", file=sys.stderr)
        raise SystemExit(2)
    mcp["servers"] = servers
    config["mcp"] = mcp
    return servers


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: opencode-skill-source SKILLS_DIR", file=sys.stderr)
        return 2

    raw = os.environ.get("OPENCODE_CONFIG_CONTENT", "").strip()
    try:
        config = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        print("Invalid OPENCODE_CONFIG_CONTENT; refusing to replace user inline configuration", file=sys.stderr)
        return 2
    if not isinstance(config, dict):
        print("OPENCODE_CONFIG_CONTENT must contain a JSON object", file=sys.stderr)
        return 2

    current = config.get("skills", [])
    if current is None:
        current = []
    if not isinstance(current, list) or not all(isinstance(item, str) and item for item in current):
        print("OPENCODE_CONFIG_CONTENT.skills must be an array of non-empty strings", file=sys.stderr)
        return 2

    source = Path(sys.argv[1]).expanduser().absolute()
    if source.is_symlink() or not source.is_dir():
        print("Generated OpenCode skills directory is missing or unsafe", file=sys.stderr)
        return 2

    rendered = str(source)
    config["skills"] = [*current, *([] if rendered in current else [rendered])]

    memory_target = os.environ.get("OAT_MEMORY_PLUGIN_TARGET", "").strip()
    context_file = os.environ.get("OAT_MEMORY_CONTEXT_FILE", "").strip()
    if memory_target:
        target = Path(memory_target).expanduser().absolute()
        if target.is_symlink() or not target.exists():
            print("Native memory plugin target is missing or unsafe", file=sys.stderr)
            return 2
        append_unique(config, "plugins", str(target))

        if context_file:
            context = Path(context_file).expanduser().absolute()
            if context.is_symlink() or not context.is_file():
                print("Native memory context file is missing or unsafe", file=sys.stderr)
                return 2
            instructions = config.get("instructions", [])
            if instructions is None:
                instructions = []
            if not isinstance(instructions, list) or not all(isinstance(item, str) and item for item in instructions):
                print("OPENCODE_CONFIG_CONTENT.instructions must be an array of non-empty strings", file=sys.stderr)
                return 2
            context_text = str(context)
            config["instructions"] = [*instructions, *([] if context_text in instructions else [context_text])]

        backend = os.environ.get("OAT_MEMORY_BACKEND", "legacy").strip().lower() or "legacy"
        servers = mcp_servers(config)
        if "oat-memory" not in servers:
            inherited = {}
            for name in (
                "OAT_MEMORY_ENABLED",
                "OAT_MEMORY_CAPTURE_ENABLED",
                "OAT_MEMORY_AUTO_PROMOTE",
                "OAT_MEMORY_AUTO_PUSH",
                "OAT_MEMORY_BACKEND",
                "OAT_MEMORY_REPO",
                "OAT_MEMORY_DIR",
                "OAT_MEMORY_CANDIDATE_DIR",
                "OAT_MEMORY_PROJECT",
                "OAT_MEMORY_MAX_CHARS",
                "OAT_MEMORY_EXTRA_HATS",
                "OAT_MEMORY_POSTGRES_DSN",
                "OAT_MEMORY_NAMESPACE_PREFIX",
                "OAT_MEMORY_LOCAL_PATH",
                "OAT_MEMORY_V2_RPC",
                "OAT_V2_PYTHON",
            ):
                value = os.environ.get(name, "").strip()
                if value:
                    inherited[name] = value

            if backend == "legacy":
                data_home = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
                plugin = Path(
                    os.environ.get("OAT_MEMORY_PLUGIN_DIR")
                    or data_home / "opencode-agent-toolkit" / "plugins" / "opencode-memory-plugin"
                ).expanduser().absolute()
                cli = plugin / "dist" / "cli.js"
                if cli.is_file():
                    server = {
                        "type": "local",
                        "command": ["node", str(cli), "mcp", "--cwd", os.getcwd()],
                    }
                    if inherited:
                        server["environment"] = inherited
                    servers["oat-memory"] = server
            else:
                python = os.environ.get("OAT_V2_PYTHON", "").strip()
                mcp = os.environ.get("OAT_MEMORY_V2_MCP", "").strip()
                if python and mcp and Path(python).is_file() and Path(mcp).is_file():
                    server = {
                        "type": "local",
                        "command": [python, mcp, "--cwd", os.getcwd()],
                    }
                    if inherited:
                        server["environment"] = inherited
                    servers["oat-memory"] = server

    acp_enabled = os.environ.get("OAT_ACP_ENABLED", "1").strip().lower() not in {
        "0", "false", "no", "off"
    }
    acp_child = os.environ.get("OAT_ACP_CHILD", "").strip().lower() in {
        "1", "true", "yes", "on"
    }
    if acp_enabled and not acp_child:
        servers = mcp_servers(config)
        if "oat-acp" not in servers:
            root = Path(__file__).resolve().parents[1]
            inherited = {}
            for name in (
                "OAT_ACP_DEFAULT_RUNNER",
                "OAT_ACP_MAX_PARALLEL",
                "OAT_ACP_TIMEOUT_SECONDS",
                "OPENCODE_BIN",
            ):
                value = os.environ.get(name, "").strip()
                if value:
                    inherited[name] = value
            server = {
                "type": "local",
                "command": ["python3", str(root / "scripts" / "acp-mcp"), "--cwd", os.getcwd()],
            }
            if inherited:
                server["environment"] = inherited
            servers["oat-acp"] = server

    context7_enabled = os.environ.get("OAT_CONTEXT7_ENABLED", "1").strip().lower() not in {
        "0", "false", "no", "off"
    }
    if context7_enabled:
        servers = mcp_servers(config)
        if "context7" not in servers:
            context7 = {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp",
            }
            if os.environ.get("CONTEXT7_API_KEY", "").strip():
                context7["oauth"] = False
                context7["headers"] = {
                    "Authorization": "Bearer {env:CONTEXT7_API_KEY}",
                }
            servers["context7"] = context7

    print(json.dumps(config, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
