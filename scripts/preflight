#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
major="${OPENCODE_MAJOR:-1}"

case "$major" in
  1)
    bin="${OPENCODE_BIN:-opencode}"
    config="$ROOT/opencode.jsonc"
    plugin_file="$ROOT/.opencode/plugins/reliability-v1.js"
    plugin_entry="./.opencode/plugins/reliability-v1.js"
    plugin_key="plugin"
    ;;
  2)
    bin="${OPENCODE_BIN:-opencode2}"
    config="$ROOT/opencode.v2.jsonc"
    plugin_file="$ROOT/.opencode/plugins/reliability-v2.ts"
    plugin_entry="./.opencode/plugins/reliability-v2.ts"
    plugin_key="plugins"
    ;;
  auto)
    if command -v opencode2 >/dev/null 2>&1; then
      bin="${OPENCODE_BIN:-opencode2}"
      config="$ROOT/opencode.v2.jsonc"
      plugin_file="$ROOT/.opencode/plugins/reliability-v2.ts"
      plugin_entry="./.opencode/plugins/reliability-v2.ts"
      plugin_key="plugins"
    else
      bin="${OPENCODE_BIN:-opencode}"
      config="$ROOT/opencode.jsonc"
      plugin_file="$ROOT/.opencode/plugins/reliability-v1.js"
      plugin_entry="./.opencode/plugins/reliability-v1.js"
      plugin_key="plugin"
    fi
    ;;
  *) echo "preflight: invalid OPENCODE_MAJOR=$major" >&2; exit 2 ;;
esac

fail=0
warn=0
ok() { printf '  [ok] %s\n' "$*"; }
warning() { printf '  [warn] %s\n' "$*" >&2; warn=$((warn + 1)); }
error() { printf '  [fail] %s\n' "$*" >&2; fail=$((fail + 1)); }
truthy() { [[ "${1:-1}" =~ ^(1|true|yes|on)$ ]]; }

printf 'OpenCode reliability preflight\n'

command -v "$bin" >/dev/null 2>&1 && ok "binary: $bin" || error "binary not found: $bin"
[[ -f "$config" ]] && ok "config: $config" || error "config missing: $config"
[[ -f "$ROOT/reliability.json" ]] && ok "reliability policy present" || error "reliability.json missing"
[[ -f "$plugin_file" ]] && ok "watchdog plugin: $plugin_file" || error "watchdog plugin missing: $plugin_file"

if [[ "$major" == "2" || "$major" == "auto" && "$config" == *"opencode.v2.jsonc" ]]; then
  [[ -f "$ROOT/plugins/reliability-approval/index.ts" ]] && ok "V2 approval server plugin present" || error "V2 approval server plugin missing"
  [[ -f "$ROOT/plugins/reliability-approval/tui.ts" ]] && ok "V2 approval TUI plugin present" || error "V2 approval TUI plugin missing"
fi

if [[ -f "$ROOT/reliability.json" ]]; then
  if profile_values="$(python3 - "$ROOT/reliability.json" "${RELIABILITY_PROFILE:-}" <<'PY'
import json, shlex, sys
from pathlib import Path
policy = json.loads(Path(sys.argv[1]).read_text())
name = (sys.argv[2] or policy.get("default_profile", "normal")).strip().lower()
profiles = policy.get("profiles", {})
if name not in profiles:
    raise SystemExit(f"invalid reliability profile {name!r}; expected one of: {', '.join(sorted(profiles))}")
p = profiles[name]
print("PROFILE_NAME=" + shlex.quote(name))
for key in (
    "max_parallel_subagents", "queue_timeout_seconds", "heartbeat_timeout_seconds",
    "stalled_timeout_seconds", "max_agent_duration_seconds", "max_same_error", "max_retries",
    "max_subagent_retries", "watch_interval_seconds",
):
    print("PROFILE_" + key.upper() + "=" + shlex.quote(str(p[key])))
PY
  )"; then
    eval "$profile_values"
    ok "reliability profile: $PROFILE_NAME"
  else
    error "invalid RELIABILITY_PROFILE=${RELIABILITY_PROFILE:-<default>}"
    PROFILE_MAX_PARALLEL_SUBAGENTS=3
    PROFILE_QUEUE_TIMEOUT_SECONDS=600
    PROFILE_HEARTBEAT_TIMEOUT_SECONDS=60
    PROFILE_STALLED_TIMEOUT_SECONDS=180
    PROFILE_MAX_AGENT_DURATION_SECONDS=900
    PROFILE_MAX_SAME_ERROR=2
    PROFILE_MAX_RETRIES=2
    PROFILE_MAX_SUBAGENT_RETRIES=2
    PROFILE_WATCH_INTERVAL_SECONDS=15
  fi
fi

if [[ -f "$config" ]]; then
  if python3 -m json.tool "$config" >/dev/null 2>&1; then
    ok "config JSON valid"
  else
    error "invalid JSON: $config"
  fi

  if python3 - "$config" "$plugin_key" "$plugin_entry" <<'PY' >/dev/null 2>&1
import json, sys
from pathlib import Path
config = json.loads(Path(sys.argv[1]).read_text())
raise SystemExit(0 if sys.argv[3] in config.get(sys.argv[2], []) else 1)
PY
  then
    ok "watchdog plugin wired in selected config"
  else
    error "watchdog plugin is not wired in selected config"
  fi

  if [[ "$config" == *"opencode.v2.jsonc" ]]; then
    if python3 - "$config" <<'PY' >/dev/null 2>&1
import json, sys
from pathlib import Path
config = json.loads(Path(sys.argv[1]).read_text())
raise SystemExit(0 if "./plugins/reliability-approval" in config.get("plugins", []) else 1)
PY
    then
      ok "V2 approval plugin wired in selected config"
    else
      error "V2 approval plugin is not wired in selected config"
    fi
  fi
fi

for var in MODEL_LOW MODEL_MEDIUM MODEL_HIGH; do
  value="${!var:-}"
  [[ -n "$value" ]] && ok "$var=$value" || error "$var is empty"
done

validate_positive_int() {
  local name="$1" value="$2"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] && ok "$name: $value" || error "$name must be >= 1"
}

max_parallel="${MAX_PARALLEL_SUBAGENTS:-${PROFILE_MAX_PARALLEL_SUBAGENTS:-3}}"
validate_positive_int "max parallel subagents" "$max_parallel"
for var in MAX_PARALLEL_META_ROUTER MAX_PARALLEL_ORCHESTRATOR MAX_PARALLEL_REVIEW_LEAD MAX_PARALLEL_PLATFORM_ARCHITECT MAX_PARALLEL_SECURITY_LEAD; do
  [[ -z "${!var:-}" ]] || validate_positive_int "$var" "${!var}"
done
validate_positive_int "subagent queue timeout seconds" "${SUBAGENT_QUEUE_TIMEOUT_SECONDS:-${PROFILE_QUEUE_TIMEOUT_SECONDS:-600}}"
validate_positive_int "heartbeat timeout seconds" "${SUBAGENT_HEARTBEAT_TIMEOUT_SECONDS:-${PROFILE_HEARTBEAT_TIMEOUT_SECONDS:-60}}"
validate_positive_int "stalled timeout seconds" "${SUBAGENT_STALLED_TIMEOUT_SECONDS:-${PROFILE_STALLED_TIMEOUT_SECONDS:-180}}"
validate_positive_int "max agent duration seconds" "${SUBAGENT_MAX_DURATION_SECONDS:-${PROFILE_MAX_AGENT_DURATION_SECONDS:-900}}"
validate_positive_int "same error limit" "${MAX_SAME_ERROR:-${PROFILE_MAX_SAME_ERROR:-2}}"
validate_positive_int "provider retries" "${MAX_PROVIDER_RETRIES:-${PROFILE_MAX_RETRIES:-2}}"
validate_positive_int "subagent retries" "${MAX_SUBAGENT_RETRIES:-${PROFILE_MAX_SUBAGENT_RETRIES:-2}}"
validate_positive_int "watch interval seconds" "${SUBAGENT_WATCH_INTERVAL_SECONDS:-${PROFILE_WATCH_INTERVAL_SECONDS:-15}}"

if command -v git >/dev/null 2>&1; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    ok "git repository detected"
    if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
      warning "working tree is dirty; agents must preserve unrelated changes"
    else
      ok "working tree clean"
    fi
  else
    warning "current directory is not a git repository"
  fi
fi

if command -v "$bin" >/dev/null 2>&1; then
  configured_models=()
  while IFS= read -r value; do
    [[ -n "$value" ]] && configured_models+=("$value")
  done < <(python3 - "$config" <<'PY'
import json, os, re, sys
from pathlib import Path
p = Path(sys.argv[1])
if not p.exists():
    raise SystemExit(0)
data = json.loads(p.read_text())
agents = data.get("agent", data.get("agents", {}))
models = set()
for spec in agents.values():
    value = spec.get("model")
    if not value:
        continue
    match = re.fullmatch(r"\{env:([A-Za-z_][A-Za-z0-9_]*)\}", value)
    if match:
        value = os.getenv(match.group(1), "").strip()
    if value:
        models.add(value)
for value in sorted(models):
    print(value)
PY
  )

  require_auth=0
  for value in "${configured_models[@]}"; do
    provider="${value%%/*}"
    case "$provider" in github-copilot|openai|anthropic|google|google-vertex) require_auth=1 ;; esac
  done

  if truthy "${OPENCODE_PREFLIGHT_AUTH:-1}"; then
    if [[ $require_auth -eq 1 ]]; then
      if auth_output="$(OPENCODE_CONFIG="$config" "$bin" auth list 2>&1)"; then
        if printf '%s\n' "$auth_output" | grep -Eqi '(^|[^0-9])0[[:space:]]+credentials|no[[:space:]]+credentials|not[[:space:]]+authenticated'; then
          error "OpenCode reports no configured credentials for an authenticated provider"
        else
          ok "OpenCode authentication is available"
        fi
      else
        warning "could not verify provider credentials with '$bin auth list'"
      fi
    else
      ok "auth preflight not required for configured provider set"
    fi
  else
    warning "authentication preflight disabled"
  fi

  if truthy "${OPENCODE_PREFLIGHT_MODELS:-1}"; then
    if model_output="$(OPENCODE_CONFIG="$config" "$bin" models 2>&1)"; then
      for value in "${configured_models[@]}"; do
        if printf '%s\n' "$model_output" | grep -Fqx "$value"; then
          ok "model available: $value"
        else
          error "configured model not exposed by '$bin models': $value"
        fi
      done
    else
      warning "could not verify configured models with '$bin models'"
    fi
  else
    warning "model availability preflight disabled"
  fi
fi

if (( fail > 0 )); then
  printf 'Preflight failed: %d error(s), %d warning(s). No agent session was started.\n' "$fail" "$warn" >&2
  exit 3
fi

if [[ "${OPENCODE_PREFLIGHT_STRICT:-0}" == "1" && "$warn" -gt 0 ]]; then
  printf 'Preflight strict mode failed: %d warning(s)\n' "$warn" >&2
  exit 4
fi

printf 'Preflight passed: %d warning(s)\n' "$warn"
