#!/usr/bin/env python3
from __future__ import annotations

import json
import os
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LEADS = {"meta-router", "orchestrator", "review-lead", "platform-architect", "security-lead"}

DEFAULT_STEPS = {
    "meta-router": 10,
    "orchestrator": 16,
    "review-lead": 12,
    "security-lead": 12,
    "platform-architect": 14,
    "deep-reasoner": 16,
    "arbiter": 10,
    "evidence-auditor": 10,
    "terraform-terragrunt": 16,
    "debugger": 16,
    "builder": 16,
    "python-specialist": 14,
    "go-specialist": 14,
    "project-scanner": 10,
    "architecture-designer": 12,
    "aws-platform": 12,
    "kubernetes": 12,
    "tester": 12,
    "pentest": 12,
}

SUPERVISION_POLICY = """
## Delegated-work supervision
- A delegated child is not considered healthy merely because it has not returned yet. Runtime watchdog state is authoritative when available.
- Obey the configured subagent concurrency limit. Never bypass the queue by spawning equivalent children under alternate names or by duplicating the same task.
- Distinguish activity from progress. Repeated reads, repeated commands, or repeated failures without new evidence are not progress.
- If a child is BLOCKED, aborted, stalled, over budget, or hits a non-retryable provider/configuration error, consume its existing evidence/checkpoint before deciding whether a replacement is justified.
- Never restart the entire workflow just because one child failed. Resume from the last completed gate or child session whenever possible.
- Do not launch a replacement while the previous child for the same responsibility is still active.
- WAITING_PERMISSION is not a stall. Do not replace or duplicate a child merely because it is awaiting an explicit permission decision.
- Prefer deterministic stop/retry decisions from the runtime guardrails over repeated LLM attempts at the same infrastructure/authentication failure.
""".strip()


def positive_int(name: str, fallback: int) -> int:
    raw = os.getenv(name)
    if raw in {None, ""}:
        return fallback
    try:
        value = int(raw)
    except ValueError:
        raise SystemExit(f"{name} must be an integer, got {raw!r}")
    if value < 1:
        raise SystemExit(f"{name} must be >= 1, got {value}")
    return value


def step_limit(agent: str) -> int:
    default = positive_int("OC_DEFAULT_AGENT_STEPS", 12)
    fallback = DEFAULT_STEPS.get(agent, default)
    env_name = "OC_STEPS_" + agent.upper().replace("-", "_")
    return positive_int(env_name, fallback)


def patch_config(path: Path, key: str) -> None:
    data = json.loads(path.read_text())
    agents = data[key]
    for name, spec in agents.items():
        spec["steps"] = step_limit(name)
    path.write_text(json.dumps(data, indent=2) + "\n")


def patch_prompts() -> None:
    prompt_dir = ROOT / "prompts"
    for lead in LEADS:
        path = prompt_dir / f"{lead}.md"
        text = path.read_text()
        if "## Delegated-work supervision" not in text:
            path.write_text(text.rstrip() + "\n\n" + SUPERVISION_POLICY + "\n")


def main() -> None:
    patch_config(ROOT / "opencode.jsonc", "agent")
    patch_config(ROOT / "opencode.v2.jsonc", "agents")
    patch_prompts()
    print("Applied runtime step limits and delegated-work supervision policy")


if __name__ == "__main__":
    main()
