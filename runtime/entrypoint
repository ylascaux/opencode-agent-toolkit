#!/usr/bin/env bash
set -euo pipefail

cd /opt/oat

if [[ "${1:-}" != "serve" ]]; then
  exec "$@"
fi

export OPENCODE_CONFIG=/opt/oat/opencode.jsonc
export OAT_RUNTIME=container
export OAT_SANDBOX_HOST_SHELL="${OAT_SANDBOX_HOST_SHELL:-/bin/bash}"

python3 -B ./scripts/configure-local >/dev/null
eval "$(python3 -B ./scripts/resolve-models)"

if [[ "${OAT_MEMORY_ENABLED:-1}" != "0" ]]; then
  python3 -B ./scripts/configure-memory >/dev/null || true
fi
if [[ "${OAT_INSTALL_PLUGINS:-1}" != "0" ]]; then
  opencode plugin add "${OAT_MEMORY_PLUGIN:-opencode-mem@2.26.0}" >/dev/null
fi

export OPENCODE_CONFIG_CONTENT="$(
  python3 -B ./scripts/opencode-skill-source /opt/oat/.opencode/skills
)"
python3 -m json.tool "$OPENCODE_CONFIG" >/dev/null

command -v opencode >/dev/null 2>&1 || {
  echo "OpenCode 2 binary not found in runtime image" >&2
  exit 127
}

printf 'Starting OpenCode 2 server (%s) on 0.0.0.0:4096\n' "$(opencode --version 2>/dev/null || echo unknown)" >&2
exec opencode serve --hostname 0.0.0.0 --port 4096
